{
  "name": "@albergue/domain-model",
  "version": "1.0.0",
  "description": "Domain model and database schemas for Albergue Carrascalejo",
  "type": "module",
  "main": "dist/schema.js",
  "module": "dist/schema.js",
  "types": "dist/schema.d.ts",
  "exports": {
    ".": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "migration:check": "node scripts/check-migration-chain.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^6.0.2"
  }
}
