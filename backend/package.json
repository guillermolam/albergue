{
  "name": "albergue-backend",
  "version": "1.0.0",
  "description": "Backend API for Albergue Municipal Carrascalejo",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:migrate:apply": "drizzle-kit migrate --config=./drizzle.config.ts",
    "db:push": "drizzle-kit push --config=./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=./drizzle.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@albergue/api-contract": "workspace:*",
    "@albergue/domain-model": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.7",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250921.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
