{
  "name": "albergue-carrascalejo-frontend",
  "type": "module",
  "version": "1.0.0",
  "description": "Static Astro frontend for Albergue Municipal Carrascalejo - Camino de Santiago (plain CSS, RoughJS, IBM Plex)",
  "keywords": [
    "astro",
    "camino-santiago",
    "albergue",
    "static-site",
    "plain-css",
    "roughjs",
    "ibm-plex"
  ],
  "author": "Albergue Municipal Carrascalejo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && astro preview",
    "clean": "rimraf dist .astro node_modules/.cache",
    "astro-check": "astro check",
    "format": "prettier --write .",
    "lint": "tsc6 -p tsconfig.typecheck.json --noEmit",
    "type-check": "tsc6 -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@nanostores/persistent": "^1.3.5",
    "@supabase/supabase-js": "^2.116.0",
    "alpinejs": "^3.17.2",
    "animejs": "^4.5.0",
    "astro": "^7.3.2",
    "clsx": "^2.1.1",
    "jwt-decode": "^4.0.0",
    "nanostores": "^1.5.3",
    "redis": "^5.10.0",
    "roughjs": "^4.6.6",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.1",
    "@types/alpinejs": "^3.13.11",
    "@typescript/typescript6": "^6.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "rimraf": "^6.1.2",
    "wrangler": "^4.131.0"
  },
  "packageManager": "pnpm@10.29.3"
}
