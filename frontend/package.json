{
  "name": "albergue-carrascalejo-frontend",
  "type": "module",
  "version": "1.0.0",
  "description": "Static Astro frontend for Albergue Municipal Carrascalejo - Camino de Santiago (plain CSS, RoughJS, IBM Plex)",
  "keywords": [
    "astro",
    "camino-santiago",
    "albergue",
    "static-site",
    "plain-css",
    "roughjs",
    "ibm-plex"
  ],
  "author": "Albergue Municipal Carrascalejo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "astro": "astro",
    "astro:info": "astro info --copy",
    "astro:sync": "astro sync",
    "astro:sync:force": "astro sync --force",
    "astro:preferences": "astro preferences list",
    "astro:telemetry": "astro telemetry",
    "dev": "astro dev",
    "dev:background": "astro dev --background",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs --follow",
    "dev:stop": "astro dev stop",
    "build": "pnpm run build:cloudflare",
    "build:cloudflare": "pnpm run clean && wrangler types && astro build --config astro.config.cloudflare.mjs",
    "build:netlify": "pnpm run clean && astro build --config astro.config.netlify.mjs",
    "build:stormkit": "pnpm run clean && astro build --config astro.config.stormkit.mjs",
    "build:force": "pnpm run build:cloudflare --force",
    "preview": "pnpm run preview:cloudflare",
    "preview:cloudflare": "astro preview --config astro.config.cloudflare.mjs",
    "preview:netlify": "netlify dev",
    "preview:stormkit": "pnpm run build:stormkit && node dist/server/entry.mjs",
    "preview:background": "astro preview --config astro.config.cloudflare.mjs --background",
    "preview:status": "astro preview status",
    "preview:logs": "astro preview logs --follow",
    "preview:stop": "astro preview stop",
    "clean": "rimraf dist .astro node_modules/.cache",
    "check": "pnpm run type-check",
    "check:astro": "astro check --tsconfig tsconfig.typecheck.json",
    "check:astro:full": "astro check --tsconfig tsconfig.typecheck.full.json",
    "check:watch": "astro check --tsconfig tsconfig.typecheck.json --watch",
    "astro-check": "pnpm run check:astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc -p tsconfig.typecheck.json --noEmit",
    "type-check": "tsc -p tsconfig.typecheck.json --noEmit",
    "type-check:full": "tsc -p tsconfig.typecheck.full.json --noEmit",
    "generate-types": "wrangler types",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "e2e:install": "playwright install chromium",
    "deploy": "node scripts/deploy.mjs",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy",
    "deploy:cloudflare:dry-run": "pnpm run build:cloudflare && wrangler deploy --dry-run",
    "deploy:netlify": "pnpm run build:netlify && netlify deploy --prod --no-build",
    "deploy:netlify:preview": "pnpm run build:netlify && netlify deploy --no-build",
    "deploy:stormkit": "node scripts/deploy.mjs stormkit",
    "stormkit:status": "node scripts/stormkit-status.mjs",
    "start": "node dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@nanostores/persistent": "^1.3.5",
    "animejs": "^4.5.0",
    "astro": "^7.3.2",
    "clsx": "^2.1.1",
    "nanostores": "^1.5.3",
    "roughjs": "^4.6.6",
    "three": "^0.186.0",
    "webcoreui": "^1.5.0",
    "@albergue/api-contract": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/netlify": "^8.2.5",
    "@astrojs/node": "^11.1.5",
    "@playwright/test": "^1.63.0",
    "@swup/astro": "^1.8.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@unocss/vite": "^66.10.1",
    "astro-icon": "^1.2.0",
    "netlify-cli": "^27.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "rimraf": "^6.1.3",
    "sass": "1.100.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unocss": "^66.10.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  },
  "packageManager": "pnpm@10.29.3"
}
