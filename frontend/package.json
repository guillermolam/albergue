{
  "name": "albergue-carrascalejo-frontend",
  "type": "module",
  "version": "1.0.0",
  "description": "Static Astro frontend for Albergue Municipal Carrascalejo - Camino de Santiago (Radix UI, Tailwind, UnoCSS, IBM Plex)",
  "keywords": [
    "astro",
    "camino-santiago",
    "albergue",
    "static-site",
    "plain-css",
    "ibm-plex"
  ],
  "author": "Albergue Municipal Carrascalejo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "astro": "astro",
    "astro:info": "astro info --copy",
    "astro:sync": "astro sync",
    "astro:sync:force": "astro sync --force",
    "astro:preferences": "astro preferences list",
    "astro:telemetry": "astro telemetry",
    "dev": "astro dev",
    "dev:background": "astro dev --background",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs --follow",
    "dev:stop": "astro dev stop",
    "prebuild": "pnpm run build:workspace-deps",
    "prebuild:cloudflare": "pnpm run build:workspace-deps",
    "prebuild:netlify": "pnpm run build:workspace-deps",
    "prebuild:stormkit": "pnpm run build:workspace-deps",
    "build:workspace-deps": "pnpm --filter @albergue/domain-model --filter @albergue/api-contract --filter albergue-backend build",
    "build": "pnpm run build:cloudflare",
    "build:cloudflare": "pnpm run clean && wrangler types && astro build --config astro.config.cloudflare.mjs",
    "build:netlify": "pnpm run clean && astro build --config astro.config.netlify.mjs",
    "build:stormkit": "pnpm run clean && astro build --config astro.config.stormkit.mjs",
    "build:force": "pnpm run build:cloudflare --force",
    "preview": "pnpm run preview:cloudflare",
    "preview:cloudflare": "astro preview --config astro.config.cloudflare.mjs",
    "preview:netlify": "netlify dev",
    "preview:stormkit": "pnpm run build:stormkit && node dist/server/entry.mjs",
    "preview:background": "astro preview --config astro.config.cloudflare.mjs --background",
    "preview:status": "astro preview status",
    "preview:logs": "astro preview logs --follow",
    "preview:stop": "astro preview stop",
    "clean": "rimraf dist .astro node_modules/.cache",
    "check": "pnpm run type-check",
    "check:astro": "astro check --tsconfig tsconfig.typecheck.json",
    "check:astro:full": "astro check --tsconfig tsconfig.typecheck.full.json",
    "check:watch": "astro check --tsconfig tsconfig.typecheck.json --watch",
    "astro-check": "pnpm run check:astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc6 -p tsconfig.typecheck.json --noEmit",
    "type-check": "tsc6 -p tsconfig.typecheck.json --noEmit",
    "type-check:full": "tsc6 -p tsconfig.typecheck.full.json --noEmit",
    "generate-types": "wrangler types",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "e2e:install": "playwright install chromium",
    "deploy": "node scripts/deploy.mjs",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy",
    "deploy:cloudflare:dry-run": "pnpm run build:cloudflare && wrangler deploy --dry-run",
    "deploy:netlify": "pnpm run build:netlify && netlify deploy --prod --no-build",
    "deploy:netlify:preview": "pnpm run build:netlify && netlify deploy --no-build",
    "deploy:stormkit": "node scripts/deploy.mjs stormkit",
    "stormkit:status": "node scripts/stormkit-status.mjs",
    "start": "node dist/server/entry.mjs",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@albergue/api-contract": "workspace:*",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/ts-plugin": "^1.10.12",
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "2.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@smplrspace/smplr-loader": "^2.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "albergue-backend": "workspace:*",
    "animejs": "^4.5.0",
    "astro": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "markdown-it": "^15.0.2",
    "motion": "^13.4.0",
    "nanostores": "^1.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/netlify": "8.2.6",
    "@astrojs/node": "^11.1.6",
    "@astrojs/vercel": "^11.0.10",
    "@playwright/test": "^1.63.0",
    "@swup/astro": "^1.8.0",
    "@types/markdown-it": "^14.2.0",
    "@types/qrcode": "^1.5.6",
    "@unocss/vite": "^66.10.5",
    "astro-icon": "^1.2.0",
    "daisyui": "^5.7.42",
    "husky": "9.1.7",
    "netlify-cli": "^27.8.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "rimraf": "^6.1.3",
    "sass": "1.104.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unocss": "^66.10.5",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  },
  "packageManager": "pnpm@12.4.2"
}
