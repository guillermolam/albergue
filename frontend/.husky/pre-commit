#!/bin/sh
# Husky pre-commit hook – OPA policy gate + Trunk checks.
# CWD is the repo root when this hook runs.

set -e

# Collect staged file paths (exit early if nothing staged)
staged=$(git diff --cached --name-only 2>/dev/null) || staged=""
[ -z "${staged}" ] && exit 0

# Always apply the frontend package's canonical formatter before validation.
frontend_staged=$(git diff --cached --name-only --diff-filter=ACMR -- frontend 2>/dev/null) || frontend_staged=""
if [ -n "${frontend_staged}" ]; then
	printf '%s\n' "${frontend_staged}" | while IFS= read -r file; do
		pnpm --dir frontend exec prettier --write "${file#frontend/}"
	done
	printf '%s\n' "${frontend_staged}" | while IFS= read -r file; do
		git add -- "${file}"
	done
fi

# --- OPA Rego policy gate ---
# Blocks commits that violate architectural/security policies.
if [ -x "security/policies/run-opa-gate.sh" ]; then
	security/policies/run-opa-gate.sh pre-commit || exit 1
fi
