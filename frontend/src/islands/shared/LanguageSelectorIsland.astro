---
interface Props {
  className?: string;
  showFlags?: boolean;
  compact?: boolean;
}

const { className = '', showFlags = true, compact = false } = Astro.props;

// Import i18n for dynamic language loading
import { i18nActions, LANGUAGES } from '../../stores/i18nStore';

// Get current locale from store or HTML
const getLocale = () => {
  if (typeof document !== 'undefined') {
    return document.documentElement.lang || 'es';
  }
  return 'es';
};

const locale = getLocale();
const currentLanguage = i18nActions.isSupportedLocale(locale) ? LANGUAGES[locale] : LANGUAGES.es;

const initialLanguageCode = currentLanguage.code;
const initialLanguageName = currentLanguage.name;
const initialLanguageFlag = currentLanguage.flag;
---

<div
  id="language-selector"
  class={`language-selector relative ${className}`}
  data-current-language={initialLanguageCode}
  data-show-flags={showFlags}
  data-compact={compact}
>
  <button
    type="button"
    id="language-toggle"
    class={`flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-all duration-200 ${compact ? 'text-sm' : ''}`}
    aria-label="Seleccionar idioma"
    aria-expanded="false"
    aria-haspopup="menu"
    aria-controls="language-dropdown"
  >
    {showFlags && (
      <span class="text-lg" aria-hidden="true">
        {initialLanguageFlag}
      </span>
    )}
    <span class="font-medium text-gray-700">
      {compact ? initialLanguageCode.toUpperCase() : initialLanguageName}
    </span>
    <svg
      class="w-4 h-4 text-gray-500 transition-transform duration-200"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        d="M19 9l-7 7-7-7"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    </svg>
  </button>

  <div
    id="language-dropdown"
    class="absolute top-full left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-50 origin-top transition-all duration-200 motion-reduce:transition-none opacity-0 scale-95 invisible pointer-events-none"
    role="menu"
    tabindex="-1"
  >
    <div class="py-1">
      {Object.values(LANGUAGES).map((language) => (
        <button
          type="button"
          class={`w-full flex items-center gap-3 px-4 py-2 text-left hover:bg-gray-50 focus:bg-gray-50 focus:outline-none transition-colors duration-150 ${initialLanguageCode === language.code ? 'bg-primary-50 text-primary-700' : 'text-gray-700'}`}
          data-language-code={language.code}
          aria-label={`Cambiar a ${language.name}`}
          role="menuitem"
          aria-selected={initialLanguageCode === language.code}
        >
          {showFlags && (
            <span class="text-lg" aria-hidden="true">
              {language.flag}
            </span>
          )}
          <div class="flex-1">
            <div class="font-medium">{language.name}</div>
            <div class="text-sm text-gray-500">{language.code.toUpperCase()}</div>
          </div>
          {initialLanguageCode === language.code && (
            <svg class="w-4 h-4 text-primary-600" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M5 13l4 4L19 7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                fill="none"
              />
            </svg>
          )}
        </button>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    'use strict';

    const selector = document.getElementById('language-selector');
    const toggleBtn = document.getElementById('language-toggle');
    const dropdown = document.getElementById('language-dropdown');
    const showFlags = !(selector && selector.dataset.showFlags === 'false');
    const isCompact = !!(selector && selector.dataset.compact === 'true');

    let isOpen = false;

    function close() {
      isOpen = false;
      if (dropdown) {
        dropdown.classList.remove('opacity-100', 'scale-100', 'visible');
        dropdown.classList.add('opacity-0', 'scale-95', 'invisible', 'pointer-events-none');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
      }
    }

    function open() {
      isOpen = true;
      if (dropdown) {
        dropdown.classList.remove('opacity-0', 'scale-95', 'invisible', 'pointer-events-none');
        dropdown.classList.add('opacity-100', 'scale-100', 'visible');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
      }
    }

    function toggle() {
      if (isOpen) {
        close();
      } else {
        open();
      }
      if (isOpen) {
        queueMicrotask(function () {
          if (dropdown) dropdown.focus();
        });
      }
    }

    async function selectLanguage(code) {
      close();
      try {
        const response = await fetch('/api/auth/change-language', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: JSON.stringify({ locale: code, timestamp: new Date().toISOString() }),
          keepalive: true,
        });
        const data = await response.json();
        if (!response.ok || !data.success)
          throw new Error(data.error || 'Failed to change language');

        document.documentElement.lang = code;

        const foundLang = Object.values(LANGUAGES).find((l) => l.code === code) || LANGUAGES.es;

        if (toggleBtn) {
          const flagSpan = toggleBtn.querySelector('span[aria-hidden="true"]');
          const textSpan = toggleBtn.querySelector('.font-medium');
          if (flagSpan && showFlags) {
            flagSpan.textContent = foundLang.flag;
          }
          if (textSpan) {
            textSpan.textContent = isCompact ? code.toUpperCase() : foundLang.name;
          }
        }
      } catch (error) {
        console.error('Language change failed:', error);
      }
    }

    document.addEventListener('click', function (event) {
      if (selector && !selector.contains(event.target)) {
        close();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        close();
      }
    });

    if (toggleBtn) toggleBtn.addEventListener('click', toggle);

    if (dropdown) {
      dropdown.querySelectorAll('[data-language-code]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          selectLanguage(btn.getAttribute('data-language-code') || '');
        });
      });
    }
  })();
</script>

<style>
  #language-dropdown.visible {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
  .language-selector {
    display: inline-block;
  }
</style>
