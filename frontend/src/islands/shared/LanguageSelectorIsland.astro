---
type Locale = string;

const i18nStore = {
  get: () => ({
    locale: typeof window !== 'undefined' ? document.documentElement.lang || 'es' : 'es',
  }),
};

interface Language {
  code: Locale;
  name: string;
  flag: string;
}

const languages: Language[] = await (async () => {
  try {
    const res = await fetch('/api/gateway/camino-languages', {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
      },
      keepalive: true,
    });

    if (!res.ok) throw new Error(`Gateway error: ${res.status}`);
    const data = await res.json();
    return data;
  } catch (error) {
    console.warn('Failed to fetch languages from gateway:', error);
    return [
      { code: 'es', name: 'Español', flag: '🇪🇸' },
      { code: 'en', name: 'English', flag: '🇬🇧' },
      { code: 'fr', name: 'Français', flag: '🇫🇷' },
      { code: 'de', name: 'Deutsch', flag: '🇩🇪' },
      { code: 'it', name: 'Italiano', flag: '🇮🇹' },
      { code: 'pt', name: 'Português', flag: '🇵🇹' },
      { code: 'nl', name: 'Nederlands', flag: '🇳🇱' },
      { code: 'pl', name: 'Polski', flag: '🇵🇱' },
      { code: 'ko', name: '한국어', flag: '🇰🇷' },
      { code: 'ja', name: '日本語', flag: '🇯🇵' },
      { code: 'zh', name: '中文', flag: '🇨🇳' },
      { code: 'ru', name: 'Русский', flag: '🇷🇺' },
      { code: 'cs', name: 'Čeština', flag: '🇨🇿' },
      { code: 'sk', name: 'Slovenčina', flag: '🇸🇰' },
      { code: 'hu', name: 'Magyar', flag: '🇭🇺' },
      { code: 'ca', name: 'Català', flag: '🏴' },
      { code: 'eu', name: 'Euskara', flag: '🏴' },
      { code: 'gl', name: 'Galego', flag: '🏴' },
      { code: 'oc', name: 'Occitan (Aranés)', flag: '🏴' },
      { code: 'Gode', name: 'Gothic', flag: '🏴' },
    ];
  }
})();

const currentLocale = i18nStore.get().locale;
const currentLanguage = languages.find((lang) => lang.code === currentLocale) || languages[0];

const { class: className = '', showFlags = true, compact = false } = Astro.props;

const initialLanguageCode = currentLanguage.code;
const initialLanguageName = currentLanguage.name;
const initialLanguageFlag = currentLanguage.flag;
---

<div
  id="language-selector"
  class={`language-selector relative ${className}`}
  data-current-language={initialLanguageCode}
  data-show-flags={showFlags}
  data-compact={compact}
>
  <button
    type="button"
    id="language-toggle"
    class={`flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-all duration-200 ${compact ? 'text-sm' : ''}`}
    aria-label="Seleccionar idioma"
    aria-expanded="false"
    aria-haspopup="menu"
    aria-controls="language-dropdown"
  >
    {showFlags && <span class="text-lg" aria-hidden="true">{initialLanguageFlag}</span>}
    <span class="font-medium text-gray-700">{compact ? initialLanguageCode.toUpperCase() : initialLanguageName}</span>
    <svg class="w-4 h-4 text-gray-500 transition-transform duration-200" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M19 9l-7 7-7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  </button>

  <div
    id="language-dropdown"
    class="absolute top-full left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-50 origin-top transition-all duration-200 motion-reduce:transition-none opacity-0 scale-95 invisible pointer-events-none"
    role="menu"
    tabindex="-1"
  >
    <div class="py-1">
      {languages.map((language) => (
        <button
          type="button"
          class={`w-full flex items-center gap-3 px-4 py-2 text-left hover:bg-gray-50 focus:bg-gray-50 focus:outline-none transition-colors duration-150 ${initialLanguageCode === language.code ? 'bg-primary-50 text-primary-700' : 'text-gray-700'}`}
          data-language-code={language.code}
          aria-label={`Cambiar a ${language.name}`}
          role="menuitem"
          aria-selected={initialLanguageCode === language.code}
        >
          {showFlags && <span class="text-lg" aria-hidden="true">{language.flag}</span>}
          <div class="flex-1">
            <div class="font-medium">{language.name}</div>
            <div class="text-sm text-gray-500">{language.code.toUpperCase()}</div>
          </div>
          {initialLanguageCode === language.code && (
            <svg class="w-4 h-4 text-primary-600" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
          )}
        </button>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    'use strict';

    const selector = document.getElementById('language-selector');
    const toggleBtn = document.getElementById('language-toggle');
    const dropdown = document.getElementById('language-dropdown');
    const currentLang = selector?.dataset.currentLanguage || 'es';
    const showFlags = selector?.dataset.showFlags !== 'false';
    const isCompact = selector?.dataset.compact === 'true';

    let isOpen = false;

    function close() {
      isOpen = false;
      if (dropdown) {
        dropdown.classList.remove('opacity-100', 'scale-100', 'visible');
        dropdown.classList.add('opacity-0', 'scale-95', 'invisible', 'pointer-events-none');
        toggleBtn?.setAttribute('aria-expanded', 'false');
      }
    }

    function open() {
      isOpen = true;
      if (dropdown) {
        dropdown.classList.remove('opacity-0', 'scale-95', 'invisible', 'pointer-events-none');
        dropdown.classList.add('opacity-100', 'scale-100', 'visible');
        toggleBtn?.setAttribute('aria-expanded', 'true');
      }
    }

    function toggle() {
      if (isOpen) {
        close();
      } else {
        open();
      }
      if (isOpen) {
        queueMicrotask(() => dropdown?.focus());
      }
    }

    async function selectLanguage(code: string) {
      close();
      try {
        const response = await fetch('/api/auth/change-language', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ locale: code, timestamp: new Date().toISOString() }),
          keepalive: true,
        });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.error || 'Failed to change language');

        document.documentElement.lang = code;

        const language: any = { code, name: '', flag: '' };
        const langData = (selector as any)?.languages || [];
        const foundLang = langData.find((l: any) => l.code === code) || language;

        if (toggleBtn) {
          const flagSpan = toggleBtn.querySelector('span[aria-hidden="true"]');
          const textSpan = toggleBtn.querySelector('.font-medium');
          if (flagSpan && showFlags) {
            flagSpan.textContent = foundLang.flag;
          }
          if (textSpan) {
            textSpan.textContent = isCompact ? code.toUpperCase() : foundLang.name;
          }
        }
      } catch (error) {
        console.error('Language change failed:', error);
      }
    }

    document.addEventListener('click', (event) => {
      if (!selector?.contains(event.target as Node)) {
        close();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        close();
      }
    });

    toggleBtn?.addEventListener('click', toggle);

    dropdown?.querySelectorAll('[data-language-code]').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectLanguage(btn.getAttribute('data-language-code') || '');
      });
    });
  })();
</script>

<style>
  #language-dropdown.visible {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
  .language-selector {
    display: inline-block;
  }
</style>
