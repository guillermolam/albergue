---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import DoodleCard from '../components/doodle/DoodleCard.astro';
import DoodleButton from '../components/doodle/DoodleButton.astro';
import Icon from '../components/core/Icon.astro';
import { CaminoStageProgress, DailyKmLogger } from '../islands';
---

<Layout title="Mi Camino - Albergue Municipal Carrascalejo">
  <main class="bg-paper-bg">
    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-linear-to-br from-green-50 to-cream">
      <div class="absolute inset-0 sketchy-bg opacity-70"></div>
      <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold text-charcoal mb-4 font-sketch">Mi Camino</h1>
        <p class="text-xl text-dark-grey mb-6 font-handwritten">
          Tu viaje personal por el Camino de Santiago con estadísticas detalladas y progreso en
          tiempo real
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <span class="badge badge-green">📍 Etapa Actual: Mérida → Alcuéscar</span>
          <span class="badge badge-info">🎯 127 km recorridos</span>
          <span class="badge badge-warning">⏱️ 7 días en camino</span>
        </div>
      </div>
    </section>

    <!-- Progress Overview -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-charcoal mb-8 text-center font-sketch">
          Progreso General
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Overall Progress -->
          <div class="lg:col-span-2">
            <DoodleCard variant="gradient" gradient="green" padding="lg">
              <h3 class="text-xl font-bold text-charcoal mb-6 font-sketch flex items-center gap-3">
                <span class="text-3xl">📊</span>
                Avance Total
              </h3>
              <div class="space-y-6">
                <div>
                  <div class="flex justify-between mb-3">
                    <span class="text-sm font-semibold text-dark-grey">Total del Camino</span>
                    <span class="text-sm font-bold text-green-darker">15%</span>
                  </div>
                  <div class="w-full bg-green-light rounded-full h-3">
                    <div class="bg-green-dark h-3 rounded-full" style="width: 15%"></div>
                  </div>
                  <div class="flex justify-between text-sm text-dark-grey mt-2">
                    <span>127 km recorridos</span>
                    <span>720 km restantes</span>
                    <span>847 km total</span>
                  </div>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                  <div class="bg-green-light p-4 rounded-lg text-center">
                    <div class="text-2xl mb-2">📅</div>
                    <div class="text-2xl font-bold text-charcoal">7</div>
                    <div class="text-sm text-dark-grey">Días</div>
                  </div>
                  <div class="bg-green-light p-4 rounded-lg text-center">
                    <div class="text-2xl mb-2">🏃</div>
                    <div class="text-2xl font-bold text-charcoal">18.1</div>
                    <div class="text-sm text-dark-grey">km/día</div>
                  </div>
                  <div class="bg-green-light p-4 rounded-lg text-center">
                    <div class="text-2xl mb-2">⏱️</div>
                    <div class="text-2xl font-bold text-charcoal">4.2</div>
                    <div class="text-sm text-dark-grey">h/día</div>
                  </div>
                  <div class="bg-green-light p-4 rounded-lg text-center">
                    <div class="text-2xl mb-2">🔥</div>
                    <div class="text-2xl font-bold text-charcoal">18,932</div>
                    <div class="text-sm text-dark-grey">calorías</div>
                  </div>
                </div>
              </div>
            </DoodleCard>
          </div>

          <!-- Quick Stats -->
          <div class="space-y-6">
            <DoodleCard variant="elevated" padding="lg">
              <h3 class="text-lg font-bold text-charcoal mb-4 font-sketch flex items-center gap-3">
                <span class="text-2xl">⚡</span>
                Estadísticas Rápidas
              </h3>
              <div class="space-y-4">
                <div class="flex justify-between items-center p-3 bg-green-light rounded-lg">
                  <div class="flex items-center gap-3">
                    <span class="text-xl">📅</span>
                    <div>
                      <div class="font-semibold text-charcoal">7</div>
                      <div class="text-sm text-dark-grey">Días en camino</div>
                    </div>
                  </div>
                </div>
                <div class="flex justify-between items-center p-3 bg-green-light rounded-lg">
                  <div class="flex items-center gap-3">
                    <span class="text-xl">🏃</span>
                    <div>
                      <div class="font-semibold text-charcoal">18.1 km/día</div>
                      <div class="text-sm text-dark-grey">Promedio</div>
                    </div>
                  </div>
                </div>
                <div class="flex justify-between items-center p-3 bg-green-light rounded-lg">
                  <div class="flex items-center gap-3">
                    <span class="text-xl">⏱️</span>
                    <div>
                      <div class="font-semibold text-charcoal">4.2 h/día</div>
                      <div class="text-sm text-dark-grey">Caminando</div>
                    </div>
                  </div>
                </div>
              </div>
            </DoodleCard>

            <DoodleCard variant="elevated" padding="lg">
              <h3 class="text-lg font-bold text-charcoal mb-4 font-sketch flex items-center gap-3">
                <span class="text-2xl">🏆</span>
                Logros
              </h3>
              <div class="space-y-3">
                <div class="flex items-center gap-3 p-3 bg-green-light rounded-lg">
                  <span class="text-xl">🌅</span>
                  <div>
                    <div class="font-semibold text-charcoal">Amanecer Mágico</div>
                    <div class="text-sm text-dark-grey">Primer amanecer en el camino</div>
                  </div>
                </div>
                <div class="flex items-center gap-3 p-3 bg-green-light rounded-lg">
                  <span class="text-xl">🦶</span>
                  <div>
                    <div class="font-semibold text-charcoal">100km Club</div>
                    <div class="text-sm text-dark-grey">Más de 100 km completados</div>
                  </div>
                </div>
                <div class="flex items-center gap-3 p-3 bg-green-light rounded-lg opacity-50">
                  <span class="text-xl">🏔️</span>
                  <div>
                    <div class="font-semibold text-dark-grey">Montañero</div>
                    <div class="text-sm text-dark-grey">Próximamente</div>
                  </div>
                </div>
              </div>
            </DoodleCard>
          </div>
        </div>
      </div>
    </section>
    <!-- Current Stage -->
    <section class="py-16 bg-linear-to-br from-green-50 to-cream">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <CaminoStageProgress client:load />
      </div>
    </section>

    <!-- Daily Km Logger -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-2xl">
        <DailyKmLogger client:load initialKm={18.1} />
      </div>
    </section>

    <!-- Recommendations -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-charcoal mb-8 text-center font-sketch">
          <Icon name="star" size="xl" color="primary" animated /> Recomendaciones Inteligentes
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <DoodleCard variant="subtle" padding="lg">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🚨</span>
              <h3 class="text-lg font-bold text-charcoal">Importante</h3>
            </div>
            <p class="text-dark-grey mb-4">
              Considera tomarte un día de descanso en Alcuéscar. Tu ritmo ha sido constante pero
              exigente.
            </p>
            <div class="flex gap-2">
              <span class="badge badge-warning">7 días seguidos</span>
              <span class="badge badge-warning">18.1 km/día</span>
            </div>
          </DoodleCard>

          <DoodleCard variant="subtle" padding="lg">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🌟</span>
              <h3 class="text-lg font-bold text-charcoal">Optimización</h3>
            </div>
            <p class="text-dark-grey mb-4">
              Tu ritmo actual es excelente. Podrías alcanzar Santiago en 34 días si mantienes este
              ritmo.
            </p>
            <div class="flex gap-2">
              <span class="badge badge-green">Est. 34 días</span>
              <span class="badge badge-green">Ritmo óptimo</span>
            </div>
          </DoodleCard>

          <DoodleCard variant="subtle" padding="lg">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🏃</span>
              <h3 class="text-lg font-bold text-charcoal">Próxima Etapa</h3>
            </div>
            <p class="text-dark-grey mb-4">
              Alcuéscar → Cáceres (23.1 km). Etapa más corta, perfecta para recuperar energías.
            </p>
            <div class="flex gap-2">
              <span class="badge badge-info">23.1 km</span>
              <span class="badge badge-info">Est. 5-6 horas</span>
            </div>
          </DoodleCard>

          <DoodleCard variant="subtle" padding="lg">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">⚡</span>
              <h3 class="text-lg font-bold text-charcoal">Rendimiento</h3>
            </div>
            <p class="text-dark-grey mb-4">
              Has mantenido un ritmo constante. Tu velocidad promedio de 4.9 km/h es ideal para el
              Camino.
            </p>
            <div class="flex gap-2">
              <span class="badge badge-green">4.9 km/h</span>
              <span class="badge badge-green">Ritmo estable</span>
            </div>
          </DoodleCard>
        </div>
      </div>
    </section>

    <!-- Action Buttons -->
    <section class="py-16 bg-linear-to-br from-green-600 via-emerald-600 to-teal-600 text-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl font-bold mb-6 font-sketch">¿Qué te gustaría hacer?</h2>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <DoodleButton href="/booking" variant="primary" size="lg">
              🏨 Reservar Albergue
            </DoodleButton>
            <DoodleButton href="/camino" variant="outline" size="lg">
              📊 Ver Más Estadísticas
            </DoodleButton>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
