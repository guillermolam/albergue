---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import DoodleCard from '../components/doodle/DoodleCard.astro';
import DoodleButton from '../components/doodle/DoodleButton.astro';
import Icon from '../components/core/Icon.astro';
import { CaminoStageProgress } from '../islands';
import { ViaPlataSection } from '../../react/camino/ViaPlataSection';
import { DailyKmLoggerCard } from '../../react/camino/DailyKmLoggerCard';
---

<Layout title="Mi Camino - Albergue Municipal Carrascalejo">
  <main class="bg-paper-bg">
    <!-- Hero Section -->
    <section class="relative py-10 flex items-center justify-center overflow-hidden bg-linear-to-br from-green-50 to-cream">
      <div class="absolute inset-0 sketchy-bg opacity-70"></div>
      <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-bold text-charcoal mb-2 font-sketch">Mi Camino</h1>
        <p class="text-base text-dark-grey mb-4 font-handwritten">
          Tu viaje personal por el Camino de Santiago con estadísticas detalladas y progreso en
          tiempo real
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="badge badge-green">📍 Mérida → Alcuéscar</span>
          <span class="badge badge-info">🎯 127 km</span>
          <span class="badge badge-warning">⏱️ 7 días</span>
        </div>
      </div>
    </section>

    <!-- Progress Overview: single compact strip -->
    <section class="py-5 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
        <div class="rounded-xl border-2 border-green-dark/20 bg-linear-to-br from-green-50 to-cream p-4">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <h2 class="text-sm font-bold text-charcoal font-sketch flex items-center gap-1.5">
              <span class="text-base">📊</span> Progreso General
            </h2>
            <span class="text-sm font-bold text-green-darker">15% · 127 / 847 km</span>
          </div>
          <div class="w-full bg-green-light rounded-full h-2 mb-3">
            <div class="bg-green-dark h-2 rounded-full" style="width: 15%"></div>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-dark-grey">
            <span>📅 7 días</span>
            <span>🏃 18.1 km/día</span>
            <span>⏱️ 4.2 h/día</span>
            <span>🔥 18,932 cal</span>
            <span class="ml-auto flex gap-1.5 text-sm" aria-label="Logros">
              <span title="Amanecer Mágico">🌅</span>
              <span title="100km Club">🦶</span>
              <span class="opacity-40" title="Montañero (próximamente)">
                🏔️
              </span>
            </span>
          </div>
        </div>
      </div>
    </section>
    <!-- Current Stage -->
    <section class="py-8 bg-linear-to-br from-green-50 to-cream">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <CaminoStageProgress />
      </div>
    </section>

    <!-- Daily Km Logger -->
    <section class="py-8 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-2xl">
        <DailyKmLoggerCard client:load initialKm={18.1} />
      </div>
    </section>

    <!-- Recommendations -->
    <section class="py-8 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-charcoal mb-4 text-center font-sketch">
          <Icon name="star" size="lg" color="primary" animated /> Recomendaciones Inteligentes
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 max-w-5xl mx-auto">
          <DoodleCard variant="subtle" padding="sm">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-lg">🚨</span>
              <h3 class="text-sm font-bold text-charcoal">Importante</h3>
            </div>
            <p class="text-xs text-dark-grey mb-2">
              Considera descansar en Alcuéscar tras 7 días seguidos.
            </p>
            <span class="badge badge-warning badge-sm">18.1 km/día</span>
          </DoodleCard>

          <DoodleCard variant="subtle" padding="sm">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-lg">🌟</span>
              <h3 class="text-sm font-bold text-charcoal">Optimización</h3>
            </div>
            <p class="text-xs text-dark-grey mb-2">A este ritmo, llegas a Santiago en 34 días.</p>
            <span class="badge badge-green badge-sm">Ritmo óptimo</span>
          </DoodleCard>

          <DoodleCard variant="subtle" padding="sm">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-lg">🏃</span>
              <h3 class="text-sm font-bold text-charcoal">Próxima Etapa</h3>
            </div>
            <p class="text-xs text-dark-grey mb-2">
              Alcuéscar → Cáceres, la más corta para recuperar.
            </p>
            <span class="badge badge-info badge-sm">23.1 km</span>
          </DoodleCard>

          <DoodleCard variant="subtle" padding="sm">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-lg">⚡</span>
              <h3 class="text-sm font-bold text-charcoal">Rendimiento</h3>
            </div>
            <p class="text-xs text-dark-grey mb-2">Ritmo constante, 4.9 km/h de media, ideal.</p>
            <span class="badge badge-green badge-sm">Ritmo estable</span>
          </DoodleCard>
        </div>
      </div>
    </section>

    <!-- Vía de la Plata route guide: stages, map, and external resources -->
    <ViaPlataSection client:only="react" />

    <!-- Action Buttons -->
    <section class="py-10 bg-linear-to-br from-green-600 via-emerald-600 to-teal-600 text-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl font-bold mb-4 font-sketch">¿Qué te gustaría hacer?</h2>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <DoodleButton href="/booking" variant="primary" size="lg">
              🏨 Reservar Albergue
            </DoodleButton>
            <DoodleButton href="/camino" variant="outline" size="lg">
              📊 Ver Más Estadísticas
            </DoodleButton>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
