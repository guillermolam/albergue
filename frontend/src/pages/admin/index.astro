---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { Dashboard, type DashboardMetrics } from '../../../react/admin/Dashboard';
import { backendJson } from '../../lib/backend-api';

const result = await backendJson<DashboardMetrics>('/api/dashboard/metrics');
---

<AdminLayout title="Admin Dashboard" activeSection="dashboard">
  {!result.ok && (
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 mb-6">
      Could not load dashboard metrics: {result.message}
    </div>
  )}
  {result.ok && <Dashboard client:load metrics={result.data} />}
</AdminLayout>
