---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { BookingsTable, type BookingRow } from '../../../react/admin/BookingsTable';
import { backendJson } from '../../lib/backend-api';

const result = await backendJson<BookingRow[]>('/api/bookings/table');
const initialBookings = result.ok ? result.data : [];
---

<AdminLayout title="Bookings" activeSection="bookings">
  {!result.ok && (
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 mb-6">
      Could not load bookings: {result.message}
    </div>
  )}
  <BookingsTable client:load initialBookings={initialBookings} />
</AdminLayout>
