---
// Request-rendered rather than prerendered: the chat's FAQ answers depend
// on live check-in/out times from /api/hostel (same reasoning as
// hostel/services.astro's emergency numbers). Prerendering would bake
// whatever the backend returns at build time into every deploy until the
// next one -- including a permanent null if the backend happened to be
// unavailable during that build.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { ContactPage } from '../../react/ContactPage';
import { backendJson } from '../lib/backend-api';
import type { HostelAggregate } from '../lib/hostelTypes';

const hostelInfoResult = await backendJson<HostelAggregate>('/api/hostel');
const hostelInfo = hostelInfoResult.ok ? hostelInfoResult.data : null;
---

<Layout
  title="Contacto - Albergue Municipal Carrascalejo"
  description="Ponte en contacto con el Albergue Municipal Carrascalejo"
>
  <ContactPage client:load hostelInfo={hostelInfo} />
</Layout>
