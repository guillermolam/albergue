---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { DoodleCard } from '../components';
import { backendJson } from '../lib/backend-api';
import { BookingShareActions } from '../islands';
import '../styles/booking-confirmation.css';

interface ConfirmedBooking {
  id: number;
  referenceNumber: string;
  status: string;
  checkInDate: string;
  checkOutDate: string;
  numberOfNights: number;
  totalAmount: string;
}

const reference = Astro.url.searchParams.get('ref')?.trim() ?? '';
let booking: ConfirmedBooking | null = null;
let lookupError: string | undefined;

if (!reference) {
  lookupError = 'Falta la referencia de reserva.';
} else if (!/^ALB-[0-9A-F]{12}$/i.test(reference)) {
  lookupError = 'Referencia no válida.';
} else {
  const result = await backendJson<ConfirmedBooking>(
    `/api/bookings/reference/${encodeURIComponent(reference)}`
  );
  if (result.ok) {
    booking = result.data;
  } else if (result.status === 404) {
    lookupError = 'No encontramos esa reserva.';
  } else {
    lookupError = result.message;
  }
}

const nights = booking?.numberOfNights ?? 0;
---

<Layout
  title="Reserva confirmada - Albergue Municipal Carrascalejo"
  description="Confirmación de reserva"
>
  <main class="min-h-screen bg-paper-bg flex items-center justify-center p-4">
    <div class="w-full max-w-2xl">
      <DoodleCard variant="elevated" padding="lg">
        {lookupError || !booking ? (
          <div>
            <h1 class="text-2xl font-bold text-charcoal mb-2 font-sketch">Reserva no encontrada</h1>
            <p class="text-dark-grey mb-4">{lookupError}</p>
            <a href="/booking" class="text-green-700 font-semibold">
              Nueva reserva
            </a>
          </div>
        ) : (
          <div class="space-y-4">
            <h1 class="text-3xl font-bold text-charcoal font-sketch">Reserva registrada</h1>
            <p class="text-dark-grey">
              Guarda esta referencia. El pago se confirma cuando Redsys notifica al servidor.
            </p>
            <dl class="grid grid-cols-2 gap-3 text-sm">
              <dt class="text-dark-grey">Referencia</dt>
              <dd class="font-bold tracking-wider">{booking.referenceNumber}</dd>
              <dt class="text-dark-grey">Estado</dt>
              <dd class="font-bold">{booking.status}</dd>
              <dt class="text-dark-grey">Llegada</dt>
              <dd class="font-bold">{booking.checkInDate}</dd>
              <dt class="text-dark-grey">Salida</dt>
              <dd class="font-bold">{booking.checkOutDate}</dd>
              <dt class="text-dark-grey">Noches</dt>
              <dd class="font-bold">{nights}</dd>
              <dt class="text-dark-grey">Total</dt>
              <dd class="font-bold">€{booking.totalAmount}</dd>
            </dl>
            <div class="pt-4 space-x-4">
              <a href="/" class="text-green-700 font-semibold">
                ← Inicio
              </a>
              <a href="/booking" class="text-slate-600">
                Nueva reserva
              </a>
            </div>
            <BookingShareActions
              booking={{
                referenceNumber: booking.referenceNumber,
                checkInDate: booking.checkInDate,
                checkOutDate: booking.checkOutDate,
                nights,
                totalAmount: booking.totalAmount,
              }}
            />
          </div>
        )}
      </DoodleCard>
    </div>
  </main>
</Layout>
