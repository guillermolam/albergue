---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { HomePage } from '../../react/HomePage';
import { ReviewsCarousel } from '../../react/reviews/ReviewsCarousel';
import { backendJson } from '../lib/backend-api';
import type { HostelStats } from '../lib/hostelTypes';

// Bed availability is genuinely live operational data (changes as bookings
// happen), unlike the footer's mostly-static content -- this page is SSR
// (not prerendered) specifically so the homepage hero never shows a stale
// availability count.
const result = await backendJson<HostelStats>('/api/hostel/stats');
const stats = result.ok ? result.data : null;
---

<Layout
  title="Albergue Municipal Carrascalejo"
  description="Albergue de peregrinos en el Camino de Santiago"
>
  <HomePage client:load stats={stats} />
  <ReviewsCarousel client:load />
</Layout>
