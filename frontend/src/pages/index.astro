---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import DoodleIcons from '../components/doodle/DoodleIcons.astro';
import DoodleButton from '../components/doodle/DoodleButton.astro';
import DoodleCard from '../components/doodle/DoodleCard.astro';
import Icon from '../components/core/Icon.astro';
import Stats from '../components/core/Stats.astro';

const heroStats = [
  {
    label: 'Peregrinos Atendidos',
    value: '2,847',
    icon: 'pilgrim',
    color: 'primary',
    trend: 'up',
    change: '+12%',
    size: 'md',
  },
  {
    label: 'Kilómetros Promedio',
    value: '23.4',
    unit: 'km/día',
    icon: 'walking',
    color: 'success',
    trend: 'up',
    change: '+5%',
    size: 'md',
  },
  {
    label: 'Satisfacción',
    value: '4.8',
    unit: '/5',
    icon: 'star',
    color: 'warning',
    trend: 'stable',
    change: '0%',
    size: 'md',
  },
  {
    label: 'Días en Camino',
    value: '34',
    unit: 'días',
    icon: 'calendar',
    color: 'info',
    trend: 'up',
    change: '+8%',
    size: 'md',
  },
];

const features = [
  {
    icon: 'bed',
    title: 'Alojamiento Cómodo',
    description:
      'Habitaciones compartidas y privadas con todas las comodidades para el peregrino moderno.',
    color: 'primary',
  },
  {
    icon: 'shower',
    title: 'Servicios Completos',
    description: 'Duchas calientes, lavandería, cocina equipada y zonas de descanso.',
    color: 'success',
  },
  {
    icon: 'food',
    title: 'Desayuno Incluido',
    description: 'Energético desayuno caminero para empezar tu día con fuerza.',
    color: 'warning',
  },
  {
    icon: 'wifi',
    title: 'WiFi Gratis',
    description: 'Conectividad de alta velocidad para compartir tu experiencia.',
    color: 'info',
  },
];
---

<Layout title="Albergue Municipal Carrascalejo - Tu refugio en el Camino de Santiago">
  <main class="bg-paper-bg">
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-linear-to-br from-green-50 to-cream">
      <div class="absolute inset-0 sketchy-bg opacity-70"></div>
      <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
        <div class="mb-8">
          <div class="w-20 h-20 mx-auto mb-6 bg-linear-to-br from-green-500 to-emerald-600 rounded-full flex items-center justify-center shadow-xl">
            <DoodleIcons name="shell" size="xl" />
          </div>
          <h1 class="text-5xl md:text-7xl font-bold text-charcoal mb-4 tracking-tight font-sketch">
            Bienvenido al Albergue Municipal Carrascalejo
          </h1>
          <h2 class="text-2xl md:text-3xl text-dark-grey font-light font-handwritten">
            Tu refugio en la Vía de la Plata
          </h2>
        </div>

        <div class="bg-white/90 backdrop-blur-md rounded-2xl p-8 mb-8 border border-medium-grey shadow-xl max-w-4xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-charcoal">
            <div class="text-center">
              <div class="text-4xl font-bold mb-2 text-green-dark">€10</div>
              <div class="text-sm text-dark-grey uppercase tracking-wider">por noche</div>
            </div>
            <div class="text-center border-l border-medium-grey pl-6">
              <div class="text-4xl font-bold mb-2 text-green-dark">24</div>
              <div class="text-sm text-dark-grey uppercase tracking-wider">camas disponibles</div>
            </div>
            <div class="text-center border-l border-medium-grey pl-6">
              <div class="text-4xl font-bold mb-2 text-green-dark">📍</div>
              <div class="text-sm text-dark-grey uppercase tracking-wider">Vía de la Plata</div>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <DoodleButton href="/booking" variant="primary" size="lg">
            Reservar Ahora
          </DoodleButton>
          <p class="text-dark-grey text-base">
            Tu refugio en la ruta histórica de la Vía de la Plata
          </p>
        </div>
      </div>

      <div class="absolute bottom-0 left-0 right-0 h-32 bg-linear-to-t from-cream to-transparent"></div>
    </section>

    <!-- Stats Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-charcoal mb-4 font-sketch">
            <Icon name="star" size="xl" color="primary" animated /> Nuestras Cifras
          </h2>
          <p class="text-xl text-dark-grey max-w-2xl mx-auto">
            Estadísticas que demuestran nuestro compromiso con los peregrinos
          </p>
        </div>

        <Stats
          stats={heroStats}
          layout="grid"
          columns={4}
          variant="default"
          animated={true}
          gap="lg"
        />
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-16 bg-linear-to-br from-green-50 to-cream">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-charcoal mb-4 font-sketch">
            <Icon name="star" size="xl" color="secondary" animated /> Servicios Destacados
          </h2>
          <p class="text-xl text-dark-grey max-w-2xl mx-auto">
            Todo lo que necesitas para una estancia perfecta
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map((feature, index) => (
            <DoodleCard variant="elevated" padding="lg" key={index}>
              <div class="text-4xl mb-4 text-green-dark">{feature.icon}</div>
              <h3 class="text-xl font-bold text-charcoal mb-3 font-sketch">{feature.title}</h3>
              <p class="text-dark-grey leading-relaxed">{feature.description}</p>
              <div class="mt-4">
                <DoodleButton href="/info" variant="outline" size="sm">
                  Saber más
                </DoodleButton>
              </div>
            </DoodleCard>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-linear-to-br from-green-600 via-emerald-600 to-teal-600 text-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold mb-6 font-sketch">
            <Icon name="shell" size="xl" color="white" animated />
            ¿Listo para tu aventura?
          </h2>
          <p class="text-xl text-white/90 mb-8 leading-relaxed">
            Reserva tu plaza ahora y asegura tu descanso en el corazón de la Vía de la Plata. Tu
            cama te está esperando después de un largo día de caminata.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <DoodleButton href="/booking" variant="primary" size="lg">
              Reservar Ahora
            </DoodleButton>
            <DoodleButton href="/info" variant="outline" size="lg">
              Contactar
            </DoodleButton>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
