---
export const prerender = true;

import LandingLayout from '../layouts/LandingLayout.astro';

const destinations = [
  {
    name: 'Mérida',
    description: 'Roman Ruins & Amphitheater',
    distance: '35 km away',
    image:
      'https://images.unsplash.com/photo-1650103134649-5d7621808a1f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxtZXJpZGElMjByb21hbiUyMHJ1aW5zJTIwc3BhaW58ZW58MXx8fHwxNzY2MjA5NjEzfDA&ixlib=rb-4.1.0&q=80&w=1080',
  },
  {
    name: 'Vía de la Plata',
    description: 'Historic landscapes along the Camino',
    distance: 'On your route',
    image:
      'https://images.unsplash.com/photo-1711444898752-251183214453?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxwaWxncmltJTIwY2FtaW5vJTIwc3BhaW58ZW58MXx8fHwxNzY2MjA5NjE3fDA&ixlib=rb-4.1.0&q=80&w=1080',
  },
  {
    name: 'Extremadura',
    description: 'Wide skies and peaceful countryside',
    distance: 'All around you',
    image:
      'https://images.unsplash.com/photo-1601210026600-6673ca8d0a40?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxleHRyZW1hZHVyYSUyMHNwYWluJTIwbGFuZHNjYXBlfGVufDF8fHx8MTc2NjEzMTM4MXww&ixlib=rb-4.1.0&q=80&w=1080',
  },
];
---

<LandingLayout title="Albergue Municipal de El Carrascalejo">
  <section class="landing-hero" aria-labelledby="welcome-title">
    <div class="landing-hero__inner">
      <div class="landing-copy">
        <div class="landing-heart" aria-hidden="true">
          ♥
        </div>
        <h1 id="welcome-title" class="landing-title">
          ¡Bienvenido!
        </h1>
        <p class="landing-kicker">Peregrino</p>
        <div class="landing-squiggle" aria-hidden="true"></div>

        <p class="landing-intro">
          Your resting place on the historic <strong>Vía de la Plata</strong> route through
          Extremadura.
        </p>

        <div class="landing-stats" aria-label="Hostel details">
          <article class="landing-stat">
            <i aria-hidden="true"></i>
            <span>PRICE</span>
            <strong>€10</strong>
            <small>/night</small>
          </article>
          <article class="landing-stat landing-stat--beds">
            <i aria-hidden="true"></i>
            <span>BEDS</span>
            <strong>24</strong>
            <small>available</small>
          </article>
        </div>

        <a class="landing-primary-button" href="/booking">
          Start Booking Now
        </a>

        <ul class="landing-benefits" aria-label="Highlights">
          <li>
            <b aria-hidden="true">▰</b>2 dormitories with 12 beds each
          </li>
          <li>
            <b aria-hidden="true">⌖</b>Historic Camino route location
          </li>
          <li>
            <b aria-hidden="true">✓</b>Modern facilities, warm hospitality
          </li>
        </ul>
      </div>

      <div class="landing-gallery" data-carousel>
        <div class="landing-note">Tell me more... ✨</div>
        <div class="landing-frame">
          <span class="landing-spark landing-spark--one" aria-hidden="true">
            ✦
          </span>
          <span class="landing-spark landing-spark--two" aria-hidden="true">
            ✦
          </span>
          <button
            class="landing-arrow landing-arrow--previous"
            type="button"
            aria-label="Previous destination"
            data-carousel-previous
          >
            ‹
          </button>
          <button
            class="landing-arrow landing-arrow--next"
            type="button"
            aria-label="Next destination"
            data-carousel-next
          >
            ›
          </button>

          <img
            class="landing-gallery__image"
            src={destinations[0].image}
            alt="Roman ruins in Mérida"
            width="1080"
            height="720"
            data-carousel-image
          />

          <div class="landing-place-card">
            <h2 data-carousel-name>{destinations[0].name}</h2>
            <div class="landing-place-card__line" aria-hidden="true"></div>
            <div class="landing-place-card__meta">
              <span data-carousel-description>{destinations[0].description}</span>
              <span class="landing-distance">
                ⌖ <span data-carousel-distance>{destinations[0].distance}</span>
              </span>
            </div>
          </div>

          <div class="landing-dots" aria-label="Destination slides">
            {destinations.map((destination, index) => (
              <button
                type="button"
                class:list={['landing-dot', index === 0 && 'is-active']}
                aria-label={`Show ${destination.name}`}
                aria-current={index === 0 ? 'true' : undefined}
                data-carousel-dot={index}
              ></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ destinations }}>
    const carousel = document.querySelector('[data-carousel]');
    if (carousel) {
      const image = carousel.querySelector('[data-carousel-image]');
      const name = carousel.querySelector('[data-carousel-name]');
      const description = carousel.querySelector('[data-carousel-description]');
      const distance = carousel.querySelector('[data-carousel-distance]');
      const dots = [...carousel.querySelectorAll('[data-carousel-dot]')];
      let activeIndex = 0;

      const showDestination = (index) => {
        activeIndex = (index + destinations.length) % destinations.length;
        const destination = destinations[activeIndex];
        image.src = destination.image;
        image.alt = `${destination.name}: ${destination.description}`;
        name.textContent = destination.name;
        description.textContent = destination.description;
        distance.textContent = destination.distance;
        dots.forEach((dot, dotIndex) => {
          const active = dotIndex === activeIndex;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-current', active ? 'true' : 'false');
        });
      };

      carousel
        .querySelector('[data-carousel-previous]')
        ?.addEventListener('click', () => showDestination(activeIndex - 1));
      carousel
        .querySelector('[data-carousel-next]')
        ?.addEventListener('click', () => showDestination(activeIndex + 1));
      dots.forEach((dot, index) => dot.addEventListener('click', () => showDestination(index)));
    }
  </script>
</LandingLayout>
