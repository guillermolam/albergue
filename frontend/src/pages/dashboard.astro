---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import DoodleCard from '../components/doodle/DoodleCard.astro';
import DoodleButton from '../components/doodle/DoodleButton.astro';
import { UserProfileCard, DashboardBookingWidget } from '../islands';
import { CaminoProgressTracker } from '../../react/CaminoProgressTracker';
---

<Layout title="Dashboard - Albergue Municipal Carrascalejo">
  <main class="bg-paper-bg">
    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-linear-to-br from-green-50 to-cream">
      <div class="absolute inset-0 sketchy-bg opacity-70"></div>
      <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold text-charcoal mb-4 font-sketch">
          Bienvenido, Peregrino
        </h1>
        <p class="text-xl text-dark-grey mb-8 font-handwritten max-w-2xl mx-auto">
          Tu dashboard personal para gestionar tu viaje en el Camino de Santiago
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <span class="badge badge-green">📍 Vía de la Plata</span>
          <span class="badge badge-info">🎯 847 km hasta Santiago</span>
        </div>
        <div class="mt-8 flex justify-center">
          <UserProfileCard editable />
        </div>
      </div>
    </section>

    <!-- Dashboard Grid -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- My Booking -->
          <DashboardBookingWidget />

          <!-- The Hostel -->
          <DoodleCard variant="gradient" gradient="green" padding="lg">
            <div class="card-header mb-6">
              <div class="text-3xl mb-2">🏠</div>
              <h2 class="text-xl font-bold text-charcoal mb-1 font-sketch">El Albergue</h2>
              <p class="text-sm text-dark-grey">Servicios y horarios</p>
            </div>
            <div class="hostel-info space-y-3 mb-6">
              <div class="info-item flex items-center gap-3 p-3 bg-green-light rounded-lg">
                <span class="text-xl">🕐</span>
                <span class="text-sm text-dark-grey">Check-in: 14:00 - 22:00</span>
              </div>
              <div class="info-item flex items-center gap-3 p-3 bg-green-light rounded-lg">
                <span class="text-xl">🍳</span>
                <span class="text-sm text-dark-grey">Desayuno: 7:00 - 9:00</span>
              </div>
              <div class="info-item flex items-center gap-3 p-3 bg-green-light rounded-lg">
                <span class="text-xl">🧺</span>
                <span class="text-sm text-dark-grey">Lavandería disponible</span>
              </div>
            </div>
            <DoodleButton href="/info" variant="primary" size="sm" class="w-full">
              Más Info
            </DoodleButton>
          </DoodleCard>

          <!-- My Camino -->
          <DoodleCard variant="gradient" gradient="green" padding="lg">
            <div class="card-header mb-6">
              <div class="text-3xl mb-2">🥾</div>
              <h2 class="text-xl font-bold text-charcoal mb-1 font-sketch">Mi Camino</h2>
              <p class="text-sm text-dark-grey">Tu progreso y estadísticas</p>
            </div>
            <CaminoProgressTracker client:load />
            <div class="mt-4">
              <DoodleButton href="/camino" variant="primary" size="sm" class="w-full mb-2">
                Ver Mi Progreso
              </DoodleButton>
              <DoodleButton href="/demo-camino" variant="outline" size="sm" class="w-full">
                Demo Interactiva
              </DoodleButton>
            </div>
          </DoodleCard>

          <!-- Services & Attractions -->
          <DoodleCard variant="gradient" gradient="green" padding="lg" class="lg:col-span-2">
            <div class="card-header mb-6">
              <div class="text-3xl mb-2">🎯</div>
              <h2 class="text-xl font-bold text-charcoal mb-1 font-sketch">
                Servicios &amp; Atracciones
              </h2>
              <p class="text-sm text-dark-grey">Descubre lo que te rodea</p>
            </div>
            <div class="services-grid grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div class="service-item flex items-center gap-3 p-4 bg-green-light rounded-lg">
                <div class="service-icon text-2xl">🏪</div>
                <div class="service-info">
                  <h4 class="font-semibold text-charcoal">Supermercado</h4>
                  <p class="text-sm text-dark-grey">2 min a pie</p>
                </div>
              </div>
              <div class="service-item flex items-center gap-3 p-4 bg-green-light rounded-lg">
                <div class="service-icon text-2xl">⛪</div>
                <div class="service-info">
                  <h4 class="font-semibold text-charcoal">Iglesia</h4>
                  <p class="text-sm text-dark-grey">5 min a pie</p>
                </div>
              </div>
              <div class="service-item flex items-center gap-3 p-4 bg-green-light rounded-lg">
                <div class="service-icon text-2xl">🏥</div>
                <div class="service-info">
                  <h4 class="font-semibold text-charcoal">Farmacia</h4>
                  <p class="text-sm text-dark-grey">3 min a pie</p>
                </div>
              </div>
              <div class="service-item flex items-center gap-3 p-4 bg-green-light rounded-lg">
                <div class="service-icon text-2xl">☕</div>
                <div class="service-info">
                  <h4 class="font-semibold text-charcoal">Cafetería</h4>
                  <p class="text-sm text-dark-grey">1 min a pie</p>
                </div>
              </div>
            </div>
            <DoodleButton href="/info" variant="primary" size="sm" class="w-full">
              Ver Mapa Completo
            </DoodleButton>
          </DoodleCard>

          <!-- Emergency Contacts -->
          <DoodleCard variant="gradient" gradient="green" padding="lg">
            <div class="card-header mb-6">
              <div class="text-3xl mb-2">🚨</div>
              <h2 class="text-xl font-bold text-charcoal mb-1 font-sketch">Emergencias</h2>
              <p class="text-sm text-dark-grey">Contactos importantes</p>
            </div>
            <div class="emergency-contacts space-y-3">
              <div class="contact-item flex items-center gap-3 p-3 bg-green-light rounded-lg">
                <div class="contact-icon text-xl">📞</div>
                <div class="contact-info flex-1">
                  <h4 class="font-semibold text-charcoal">Emergencias</h4>
                  <p class="text-sm text-dark-grey">112</p>
                </div>
                <a href="tel:112" class="contact-button text-sm font-semibold text-green-darker">
                  Llamar
                </a>
              </div>
              <div class="contact-item flex items-center gap-3 p-3 bg-green-light rounded-lg">
                <div class="contact-icon text-xl">🏥</div>
                <div class="contact-info flex-1">
                  <h4 class="font-semibold text-charcoal">Ambulancia</h4>
                  <p class="text-sm text-dark-grey">924 123 456</p>
                </div>
                <a
                  href="tel:+34924123456"
                  class="contact-button text-sm font-semibold text-green-darker"
                >
                  Llamar
                </a>
              </div>
              <div class="contact-item flex items-center gap-3 p-3 bg-green-light rounded-lg">
                <div class="contact-icon text-xl">👮</div>
                <div class="contact-info flex-1">
                  <h4 class="font-semibold text-charcoal">Policía</h4>
                  <p class="text-sm text-dark-grey">092</p>
                </div>
                <a href="tel:092" class="contact-button text-sm font-semibold text-green-darker">
                  Llamar
                </a>
              </div>
            </div>
            <DoodleButton href="/info" variant="outline" size="sm" class="w-full">
              Ver Todos
            </DoodleButton>
          </DoodleCard>
        </div>

        <!-- Quick Actions -->
        <div class="mt-12 bg-white rounded-2xl shadow-xl p-8 border border-medium-grey">
          <h3 class="text-2xl font-bold text-charcoal mb-6 text-center font-sketch">
            Acciones Rápidas
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <button class="quick-action-button bg-green-light rounded-xl p-4 hover:bg-green-light/80 transition-colors">
              <span class="quick-icon text-2xl">📍</span>
              <span class="quick-text text-sm font-semibold text-charcoal">
                Compartir Ubicación
              </span>
            </button>
            <button class="quick-action-button bg-green-light rounded-xl p-4 hover:bg-green-light/80 transition-colors">
              <span class="quick-icon text-2xl">📸</span>
              <span class="quick-text text-sm font-semibold text-charcoal">Foto del Día</span>
            </button>
            <button class="quick-action-button bg-green-light rounded-xl p-4 hover:bg-green-light/80 transition-colors">
              <span class="quick-icon text-2xl">✍️</span>
              <span class="quick-text text-sm font-semibold text-charcoal">Nota de Viaje</span>
            </button>
            <button class="quick-action-button bg-green-light rounded-xl p-4 hover:bg-green-light/80 transition-colors">
              <span class="quick-icon text-2xl">⭐</span>
              <span class="quick-text text-sm font-semibold text-charcoal">Valorar Albergue</span>
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
