---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { AreaDoPage } from '../../../react/area/AreaDoPage';
import {
  CulturalEventsSection,
  type CulturalEvent,
} from '../../../react/area/CulturalEventsSection';
import { NightlifeSection } from '../../../react/area/NightlifeSection';
import { backendJson } from '../../lib/backend-api';
import type { PlaceWithDetails } from '../../../react/places/types';

const NIGHTLIFE_CATEGORIES = new Set(['bar', 'night_club']);

const [eventsResult, placesResult] = await Promise.all([
  backendJson<CulturalEvent[]>('/api/merida-events'),
  backendJson<PlaceWithDetails[]>('/api/places'),
]);

const events = eventsResult.ok ? eventsResult.data : [];
const nightlifePlaces = placesResult.ok
  ? placesResult.data.filter((p) => NIGHTLIFE_CATEGORIES.has(p.category))
  : [];
---

<Layout
  title="Qué Hacer - Albergue Municipal Carrascalejo"
  description="Información turística, agenda cultural y ocio nocturno en Carrascalejo y la zona"
>
  <CulturalEventsSection client:load events={events} />
  <AreaDoPage client:load />
  <NightlifeSection client:load places={nightlifePlaces} />
</Layout>
