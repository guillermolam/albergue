---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import DoodleCard from '../components/doodle/DoodleCard.astro';
import DoodleButton from '../components/doodle/DoodleButton.astro';
import Icon from '../components/core/Icon.astro';
---

<Layout title="Reservar Albergue - Albergue Municipal Carrascalejo">
  <main class="bg-paper-bg">
    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-linear-to-br from-green-50 to-cream">
      <div class="absolute inset-0 sketchy-bg opacity-70"></div>
      <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold text-charcoal mb-4 font-sketch">
          Reserva tu Albergue
        </h1>
        <p class="text-xl text-dark-grey mb-8 font-handwritten">
          Encuentra y reserva tu próximo refugio en el Camino de Santiago
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <DoodleButton href="/booking" variant="primary" size="lg">
            Reservar Ahora
          </DoodleButton>
          <DoodleButton href="/info" variant="outline" size="lg">
            Ver Disponibilidad
          </DoodleButton>
        </div>
      </div>
    </section>

    <!-- Booking Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
          <!-- Booking Form -->
          <DoodleCard variant="elevated" padding="lg">
            <h2 class="text-2xl font-bold text-charcoal mb-6 font-sketch flex items-center gap-3">
              <span class="text-3xl">🏨</span>
              Información de Reserva
            </h2>
            <form class="space-y-6">
              <div>
                <label class="block text-sm font-semibold text-dark-grey mb-2">
                  Nombre completo
                </label>
                <input type="text" placeholder="Ingresa tu nombre completo" class="input w-full" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-dark-grey mb-2">Email</label>
                <input type="email" placeholder="tu@email.com" class="input w-full" />
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-dark-grey mb-2">
                    Fecha de entrada
                  </label>
                  <input type="date" class="input w-full" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-dark-grey mb-2">Noches</label>
                  <select class="input w-full">
                    <option value="">Selecciona</option>
                    {Array.from({ length: 10 }, (_, i) => (
                      <option value={i + 1}>
                        {i + 1} {i === 0 ? 'noche' : 'noches'}
                      </option>
                    ))}
                  </select>
                </div>
              </div>
              <div>
                <label class="block text-sm font-semibold text-dark-grey mb-2">
                  Albergue preferido
                </label>
                <select class="input w-full">
                  <option value="">Selecciona un albergue</option>
                  <option value="carrascalejo">Albergue Municipal Carrascalejo</option>
                  <option value="merida">Albergue de Mérida</option>
                  <option value="zafra">Albergue de Zafra</option>
                  <option value="villafranca">Albergue de Villafranca</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-semibold text-dark-grey mb-2">
                  Comentarios (opcional)
                </label>
                <textarea
                  rows="4"
                  placeholder="¿Alguna necesidad especial?"
                  class="input w-full resize-none"
                ></textarea>
              </div>
              <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <DoodleButton variant="primary" size="md" class="flex-1">
                  Reservar Ahora
                </DoodleButton>
                <DoodleButton variant="outline" size="md" class="flex-1">
                  Contactar
                </DoodleButton>
              </div>
            </form>
          </DoodleCard>

          <!-- Progress Panel -->
          <DoodleCard variant="gradient" gradient="green" padding="lg">
            <h2 class="text-2xl font-bold text-charcoal mb-6 font-sketch flex items-center gap-3">
              <span class="text-3xl">📊</span>
              Tu Progreso en el Camino
            </h2>
            <div class="space-y-6">
              <div>
                <div class="flex justify-between mb-3">
                  <span class="text-sm font-semibold text-dark-grey">Progreso total</span>
                  <span class="text-sm font-bold text-green-darker">15%</span>
                </div>
                <div class="w-full bg-green-light rounded-full h-3">
                  <div class="bg-green-dark h-3 rounded-full" style="width: 15%"></div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-green-light p-4 rounded-lg text-center">
                  <div class="text-2xl font-bold text-green-dark">127</div>
                  <div class="text-sm text-dark-grey">km recorridos</div>
                </div>
                <div class="bg-green-light p-4 rounded-lg text-center">
                  <div class="text-2xl font-bold text-green-dark">7</div>
                  <div class="text-sm text-dark-grey">Días en camino</div>
                </div>
              </div>
            </div>
          </DoodleCard>
        </div>
      </div>
    </section>

    <!-- Tips Section -->
    <section class="py-16 bg-linear-to-br from-green-50 to-cream">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-charcoal mb-8 font-sketch">
          <Icon name="star" size="xl" color="primary" animated /> Consejos para tu Reserva
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
          <DoodleCard variant="subtle" padding="md">
            <div class="text-3xl mb-3">📅</div>
            <h3 class="font-bold text-charcoal mb-2 font-sketch">Anticipación</h3>
            <p class="text-sm text-dark-grey">Reserva con anticipación durante temporada alta</p>
          </DoodleCard>
          <DoodleCard variant="subtle" padding="md">
            <div class="text-3xl mb-3">💰</div>
            <h3 class="font-bold text-charcoal mb-2 font-sketch">Precios</h3>
            <p class="text-sm text-dark-grey">Precio estándar: €12 por noche, incluye desayuno</p>
          </DoodleCard>
          <DoodleCard variant="subtle" padding="md">
            <div class="text-3xl mb-3">⏰</div>
            <h3 class="font-bold text-charcoal mb-2 font-sketch">Horarios</h3>
            <p class="text-sm text-dark-grey">Entrada: 15:00, Salida: 11:00</p>
          </DoodleCard>
        </div>
      </div>
    </section>
  </main>
</Layout>
