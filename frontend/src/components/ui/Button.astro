---
/**
 * Button Component - WebcoreUI Wrapper
 *
 * Variants (mapped to WebcoreUI themes):
 * - primary: Green background (default) -> 'primary'
 * - secondary: Light green background -> 'secondary'
 * - outline: Green border, transparent background -> 'outline'
 * - ghost: Transparent with hover effect -> 'flat'
 * - doodle: Hand-drawn sketchy style -> 'primary' with custom class
 *
 * Sizes:
 * - sm: Small
 * - md: Medium (default)
 * - lg: Large
 * - icon: Icon only (square)
 * - circle: Circle (for icons)
 */

import { Button as WcButton } from 'webcoreui/astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'doodle';
  size?: 'sm' | 'md' | 'lg' | 'icon' | 'circle';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
  href?: string;
  className?: string;
  children?: string | JSX.Element;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  disabled = false,
  loading = false,
  fullWidth = false,
  href,
  className = '',
  children,
} = Astro.props;

// Map our variants to WebcoreUI themes
const themeMap: Record<string, string> = {
  primary: 'primary',
  secondary: 'secondary',
  outline: 'outline',
  ghost: 'flat',
  doodle: 'primary', // Will use custom class for doodle styling
};

// Map sizes to WebcoreUI - WebcoreUI doesn't have size props, use className
const sizeClassMap: Record<string, string> = {
  sm: 'w-button-sm',
  md: '',
  lg: 'w-button-lg',
  icon: 'w-button-icon',
  circle: 'w-button-circle',
};

const theme = themeMap[variant] || 'primary';
const sizeClass = sizeClassMap[size] || '';
const fullWidthClass = fullWidth ? 'w-full' : '';
const customClasses = `${sizeClass} ${fullWidthClass} ${className}`.trim();

// Handle doodle variant with custom styling
const isDoodle = variant === 'doodle';

if (isDoodle) {
  // Use custom class for doodle variant
}
---

<WcButton
  theme={theme}
  type={type}
  disabled={disabled || loading}
  aria-busy={loading}
  href={href}
  className={customClasses}
>
  {loading && (
    <svg
      class="animate-spin h-5 w-5 mr-2"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
    >
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
      <path
        class="opacity-75"
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
      />
    </svg>
  )}
  <slot />
</WcButton>

<style>
  /* Custom size classes for WebcoreUI Button */
  .w-button-sm {
    font-size: var(--w-font-size-xs, 12px);
    padding: var(--w-spacing-xxs, 2px) var(--w-spacing-sm, 10px);
  }

  .w-button-lg {
    font-size: var(--w-font-size-lg, 21px);
    padding: var(--w-spacing-md, 15px) var(--w-spacing-xl, 30px);
  }

  .w-button-icon {
    aspect-ratio: 1;
    padding: var(--w-spacing-sm, 10px);
  }

  .w-button-circle {
    aspect-ratio: 1;
    padding: var(--w-spacing-sm, 10px);
    border-radius: 9999px;
  }

  .w-full {
    width: 100%;
  }
</style>
