---
/**
 * Button Component - Matching Figma Design
 *
 * Variants:
 * - primary: Green background (default)
 * - secondary: Light green background
 * - outline: Green border, transparent background
 * - ghost: Transparent with hover effect
 * - doodle: Hand-drawn sketchy style
 *
 * Sizes:
 * - sm: Small
 * - md: Medium (default)
 * - lg: Large
 * - icon: Icon only (square)
 * - circle: Circle (for icons)
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'doodle';
  size?: 'sm' | 'md' | 'lg' | 'icon' | 'circle';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  disabled = false,
  loading = false,
  fullWidth = false,
} = Astro.props;

const baseClasses = `btn ${fullWidth ? 'w-full' : ''}`;

const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  outline: 'btn-outline',
  ghost: 'btn-ghost',
  doodle: 'btn-doodle',
};

const sizeClasses = {
  sm: 'btn-sm',
  md: '',
  lg: 'text-lg px-6 py-4',
  icon: 'btn-icon',
  circle: 'btn-circle',
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]}`;
---

<button
  type={type}
  class={classes}
  disabled={disabled || loading}
  aria-busy={loading}
>
  {loading && (
    <svg
      class="animate-spin h-5 w-5 mr-2"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
    >
      <circle
        class="opacity-25"
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        stroke-width="4"
      />
      <path
        class="opacity-75"
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
      />
    </svg>
  )}
  <slot />
</button>
