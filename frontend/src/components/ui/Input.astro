---
/**
 * Input Component - WebcoreUI Wrapper
 *
 * Variants (mapped to WebcoreUI themes):
 * - default -> default (no theme)
 * - doodle -> 'fill' theme with custom class
 *
 * Props:
 * - type: Input type (text, email, password, etc.)
 * - placeholder: Placeholder text
 * - label: Label text
 * - error: Error message
 * - helper: Helper text
 * - required: Required field
 * - disabled: Disabled state
 */

import { Input as WcInput } from 'webcoreui/astro';

interface Props {
  variant?: 'default' | 'doodle';
  type?: 'text' | 'email' | 'password' | 'tel' | 'url' | 'number' | 'date' | 'search';
  id?: string;
  name?: string;
  placeholder?: string;
  label?: string;
  error?: string;
  helper?: string;
  required?: boolean;
  disabled?: boolean;
  className?: string;
  value?: string;
}

const {
  variant = 'default',
  type = 'text',
  id,
  name,
  placeholder,
  label,
  error,
  helper,
  required = false,
  disabled = false,
  className = '',
  value,
} = Astro.props;

const inputId = id || name;
const hasError = !!error;

// Map variant to WebcoreUI theme
const theme = variant === 'doodle' ? 'fill' : undefined;
const errorTheme = hasError ? 'alert' : theme;
const finalTheme = errorTheme || undefined;

const inputClasses = `${className}`.trim();
---

<div class="w-full">
  {label && (
    <label for={inputId} class="w-input-label">
      {label}
      {required && (
        <span class="w-input-required" aria-hidden="true">
          *
        </span>
      )}
    </label>
  )}

  <WcInput
    type={type}
    id={inputId}
    name={name}
    placeholder={placeholder}
    theme={finalTheme}
    required={required}
    disabled={disabled}
    aria-invalid={hasError}
    aria-describedby={hasError ? `${inputId}-error` : helper ? `${inputId}-helper` : undefined}
    className={inputClasses}
    value={value}
  />

  {hasError && (
    <p id={`${inputId}-error`} class="w-input-error" role="alert">
      {error}
    </p>
  )}

  {helper && !hasError && (
    <p id={`${inputId}-helper`} class="w-input-helper">
      {helper}
    </p>
  )}
</div>

<style>
  /* Label styling */
  .w-input-label {
    display: block;
    font-size: var(--w-font-size-sm, 14px);
    font-weight: 500;
    color: var(--w-color-primary-70, #1b5e20);
    margin-bottom: var(--w-spacing-xs, 5px);
  }

  .w-input-required {
    color: var(--w-color-alert, #ed1c24);
    margin-left: var(--w-spacing-xxs, 2px);
  }

  /* Error message */
  .w-input-error {
    margin-top: var(--w-spacing-xs, 5px);
    font-size: var(--w-font-size-sm, 14px);
    color: var(--w-color-alert, #ed1c24);
  }

  /* Helper text */
  .w-input-helper {
    margin-top: var(--w-spacing-xs, 5px);
    font-size: var(--w-font-size-sm, 14px);
    color: var(--w-color-primary-40, #4caf50);
  }
</style>
