---
export interface Column<T = Record<string, unknown>> {
  key: keyof T | string;
  label: string;
  sortable?: boolean;
  render?: (value: unknown, row: T) => string;
}

export interface Props<T = Record<string, unknown>> {
  data: T[];
  columns: Column<T>[];
  caption?: string;
  sortable?: boolean;
  filterable?: boolean;
  pageSize?: number;
}

const {
  data = [],
  columns = [],
  caption = '',
  sortable = true,
  filterable = true,
  pageSize = 10,
} = Astro.props;
---

<data-table
  class="block"
  data-page-size={String(pageSize)}
  data-sortable={String(sortable)}
  data-filterable={String(filterable)}
>
  <!-- Server-rendered fallback -->
  <div class="overflow-x-auto rounded-lg border border-base-300">
    <table class="table w-full">
      {caption && (
        <caption class="caption-bottom text-sm text-base-content/60 pb-2">{caption}</caption>
      )}
      <thead class="bg-base-200">
        <tr>
          {columns.map((col) => (
            <th class="px-4 py-3 text-left font-semibold text-charcoal">
              {sortable ? (
                <span class="sortable-header cursor-pointer select-none">
                  {col.label}
                  <span class="ml-1 opacity-50">↕</span>
                </span>
              ) : (
                col.label
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {data.map((row, ri) => (
          <tr key={ri} className={ri % 2 === 0 ? 'bg-base-100' : 'bg-base-200/50'}>
            {columns.map((col) => {
              const value = row[col.key as keyof typeof row];
              const rendered = col.render ? col.render(value, row) : String(value ?? '');
              return <td class="px-4 py-3 text-dark-grey font-handwritten">{rendered}</td>;
            })}
          </tr>
        ))}
        {data.length === 0 && (
          <tr>
            <td colspan={columns.length} class="px-4 py-8 text-center text-base-content/60">
              No hay datos para mostrar
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</data-table>

<script is:inline>
  (function () {
    'use strict';

    const root = document.querySelector('data-table');
    if (!root) return;

    const table = root.querySelector('table');
    if (!table) return;

    const thead = table.querySelector('thead');
    const tbody = table.querySelector('tbody');
    if (!thead || !tbody) return;

    const pageSize = parseInt(root.dataset.pageSize || '10', 10);
    const sortable = root.dataset.sortable === 'true';
    const filterable = root.dataset.filterable === 'true';

    // Parse server rows into JS data
    let allRows = [];
    tbody.querySelectorAll('tr').forEach((tr) => {
      const cells = tr.querySelectorAll('td');
      if (cells.length === 0) return;
      const row = {};
      cells.forEach((cell, i) => {
        const key = thead.querySelectorAll('th')[i]?.dataset.key || 'col' + i;
        row[key] = cell.textContent.trim();
      });
      allRows.push(row);
    });

    // Remove the "no data" row
    if (allRows.length === 1 && Object.keys(allRows[0]).length === 1) {
      allRows = [];
    }

    let sortKey = null;
    let sortDir = 'asc';
    let filter = '';
    let currentPage = 1;

    const headers = thead.querySelectorAll('th');
    headers.forEach((th, i) => {
      th.dataset.key = th.textContent.trim();
    });

    function render() {
      let filtered = allRows;
      if (filter) {
        filtered = allRows.filter((row) =>
          Object.values(row).some((v) => String(v).toLowerCase().includes(filter.toLowerCase()))
        );
      }

      if (sortKey) {
        filtered.sort((a, b) => {
          const av = String(a[sortKey] || '');
          const bv = String(b[sortKey] || '');
          const cmp = av.localeCompare(bv);
          return sortDir === 'asc' ? cmp : -cmp;
        });
      }

      const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
      if (currentPage > totalPages) currentPage = totalPages;
      const start = (currentPage - 1) * pageSize;
      const page = filtered.slice(start, start + pageSize);

      tbody.innerHTML = '';
      if (page.length === 0) {
        const tr = document.createElement('tr');
        const td = document.createElement('td');
        td.colspan = headers.length;
        td.className = 'px-4 py-8 text-center text-base-content/60';
        td.textContent = 'No hay datos para mostrar';
        tr.appendChild(td);
        tbody.appendChild(tr);
        return;
      }

      page.forEach((row) => {
        const tr = document.createElement('tr');
        headers.forEach((th) => {
          const td = document.createElement('td');
          td.className = 'px-4 py-3 text-dark-grey font-handwritten';
          td.textContent = row[th.dataset.key] || '';
          tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });

      renderPagination(totalPages);
    }

    function renderPagination(totalPages) {
      let pager = root.querySelector('.data-table-pagination');
      if (!pager) {
        pager = document.createElement('div');
        pager.className =
          'data-table-pagination flex items-center justify-between px-4 py-3 bg-base-100 border-t border-base-300';
        root.appendChild(pager);
      }
      pager.innerHTML = '';
      if (totalPages <= 1) return;

      const prevBtn = document.createElement('button');
      prevBtn.textContent = '← Anterior';
      prevBtn.className = 'btn btn-ghost btn-sm';
      prevBtn.disabled = currentPage === 1;
      prevBtn.addEventListener('click', () => {
        currentPage--;
        render();
      });
      pager.appendChild(prevBtn);

      const info = document.createElement('span');
      info.className = 'text-sm text-base-content/60';
      info.textContent = `Página ${currentPage} de ${totalPages}`;
      pager.appendChild(info);

      const nextBtn = document.createElement('button');
      nextBtn.textContent = 'Siguiente →';
      nextBtn.className = 'btn btn-ghost btn-sm';
      nextBtn.disabled = currentPage === totalPages;
      nextBtn.addEventListener('click', () => {
        currentPage++;
        render();
      });
      pager.appendChild(nextBtn);
    }

    if (sortable) {
      headers.forEach((th) => {
        th.addEventListener('click', () => {
          sortKey = th.dataset.key;
          sortDir = sortDir === 'asc' ? 'desc' : 'asc';
          headers.forEach((h) => {
            h.classList.remove('text-primary', 'font-bold');
            h.querySelector('span')?.removeAttribute('class');
          });
          th.classList.add('text-primary', 'font-bold');
          render();
        });
      });
    }

    render();
  })();
</script>
