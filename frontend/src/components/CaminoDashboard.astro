---
// CaminoDashboard component - now native Astro with client-side interactivity
const stats = {
  totalDistance: 847,
  completedDistance: 127,
  remainingDistance: 720,
  completedDays: 7,
  averageDailyDistance: 18.1,
};
const stages = [
  {
    id: '1',
    name: 'Sevilla → Guillena',
    distance: 22.2,
    completed: true,
    difficulty: 'easy',
    estimatedDays: 1,
  },
  {
    id: '2',
    name: 'Guillena → Castilblanco',
    distance: 18.5,
    completed: true,
    difficulty: 'easy',
    estimatedDays: 1,
  },
  {
    id: '3',
    name: 'Castilblanco → Almadén',
    distance: 25.8,
    completed: true,
    difficulty: 'medium',
    estimatedDays: 1,
  },
  {
    id: '4',
    name: 'Almadén → Real de la Jara',
    distance: 19.3,
    completed: true,
    difficulty: 'easy',
    estimatedDays: 1,
  },
  {
    id: '5',
    name: 'Real de la Jara → Monesterio',
    distance: 21.7,
    completed: true,
    difficulty: 'medium',
    estimatedDays: 1,
  },
  {
    id: '6',
    name: 'Monesterio → Fuente de Cantos',
    distance: 19.4,
    completed: true,
    difficulty: 'easy',
    estimatedDays: 1,
  },
  {
    id: '7',
    name: 'Fuente de Cantos → Zafra',
    distance: 20.1,
    completed: true,
    difficulty: 'easy',
    estimatedDays: 1,
  },
  {
    id: '8',
    name: 'Zafra → Villafranca',
    distance: 19.8,
    completed: false,
    difficulty: 'medium',
    estimatedDays: 1,
  },
  {
    id: '9',
    name: 'Villafranca → Alcuéscar',
    distance: 38.2,
    completed: false,
    difficulty: 'hard',
    estimatedDays: 2,
  },
  {
    id: '10',
    name: 'Alcuéscar → Cáceres',
    distance: 23.1,
    completed: false,
    difficulty: 'medium',
    estimatedDays: 1,
  },
];
const funFacts = [
  {
    icon: '🌍',
    title: 'Has caminado el equivalente a...',
    description:
      '¡Cruzar la península ibérica de este a oeste! Tu distancia recorrida es similar a la anchura de España en su punto más estrecho.',
    calculation: '127 km ≈ Ancho de España (mínimo)',
  },
  {
    icon: '🔥',
    title: 'Calorías quemadas',
    description:
      'Las 18,932 calorías equivalen a 37 bocadillos de tortilla española o 75 cafés con leche. ¡Eso es mucha energía!',
    calculation: '18,932 cal ÷ 510 cal/bocadillo = 37 bocadillos',
  },
  {
    icon: '👣',
    title: 'Pasos dados',
    description:
      'Tus 168,420 pasos equivalen a subir y bajar la Torre Eiffel aproximadamente 28 veces. ¡Qué altura!',
    calculation: '168,420 pasos ÷ 6,000 pasos/ascenso = 28 ascensos',
  },
  {
    icon: '⏰',
    title: 'Tiempo de calidad',
    description:
      'Has pasado 29.4 horas caminando, lo que equivale a ver 14 películas largas o leer 147 páginas de un buen libro.',
    calculation: '29.4 hrs ÷ 2.1 hrs/película = 14 películas',
  },
];
const progressPct = Math.round(
  (stages.filter((stage) => stage.completed).length / stages.length) * 100
);
const pendingStages = stages.filter((stage) => !stage.completed);
const difficultyPill = (difficulty: string) =>
  ({
    easy: 'text-green-700 bg-green-50 ring-green-200',
    medium: 'text-yellow-800 bg-yellow-50 ring-yellow-200',
    hard: 'text-red-700 bg-red-50 ring-red-200',
  })[difficulty] ?? 'text-stone-700 bg-stone-50 ring-stone-200';
---

<section class="mx-auto max-w-6xl px-4 py-10" data-hydrated="true">
  <div class="mb-8 flex items-start justify-between gap-6">
    <div>
      <div class="flex items-center gap-3">
        <span class="text-3xl">👣</span>
        <h1 class="text-2xl font-700 tracking-tight">Camino Dashboard</h1>
      </div>
      <div class="mt-2 text-stone-600">Mérida, España · 38.9141° N, 6.3370° W</div>
    </div>
    <div class="rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 p-4">
      <div class="text-sm text-stone-500 mb-2">Doodled shell</div>
      <svg width="180" height="140" viewBox="0 0 180 140" aria-label="Concha del Camino">
        <path
          d="M90 18 C50 18 25 55 30 105 Q90 130 150 105 C155 55 130 18 90 18Z M90 25V115 M58 32L78 116 M122 32L102 116 M38 58L67 119 M142 58L113 119"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
        />
      </svg>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 p-5">
      <div class="text-2xl font-800">{stats.completedDistance}</div>
      <div class="text-sm text-stone-500">km recorridos</div>
    </div>
    <div class="rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 p-5">
      <div class="text-2xl font-800">{stats.completedDays}</div>
      <div class="text-sm text-stone-500">días en camino</div>
    </div>
    <div class="rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 p-5">
      <div class="text-2xl font-800">{progressPct}%</div>
      <div class="text-sm text-stone-500">completado</div>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 p-6">
      <div class="flex justify-between">
        <h2 class="text-lg font-700">Progreso General</h2>
        <span id="overall-progress">68%</span>
      </div>
      <div class="mt-4 h-3 bg-stone-100 overflow-hidden">
        <div
          class="h-full bg-stone-900 transition-[width] duration-500"
          style="width: 68%"
          id="overall-progress-bar"
        ></div>
      </div>
      <div class="mt-4 grid grid-cols-3 gap-3 text-center">
        <div class="bg-stone-50 p-3 ring-1 ring-stone-200">
          <div class="text-xl font-800">{stats.completedDistance}</div>
          <div class="text-xs">km completados</div>
        </div>
        <div class="bg-stone-50 p-3 ring-1 ring-stone-200">
          <div class="text-xl font-800">{stats.remainingDistance}</div>
          <div class="text-xs">km restantes</div>
        </div>
        <div class="bg-stone-50 p-3 ring-1 ring-stone-200">
          <div class="text-xl font-800">{stats.totalDistance}</div>
          <div class="text-xs">km total</div>
        </div>
      </div>
    </div>

    <section
      aria-labelledby="current-stage-heading"
      class="rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 p-6"
    >
      <div class="flex justify-between">
        <h2 id="current-stage-heading" class="text-lg font-700">
          Etapa Actual
        </h2>
        <span id="stage-progress">68%</span>
      </div>
      <div class="mt-4 h-3 bg-stone-100 overflow-hidden">
        <div
          class="h-full bg-stone-900 transition-[width] duration-500"
          style="width: 68%"
          id="stage-progress-bar"
        ></div>
      </div>
      <div class="mt-3 flex justify-between text-sm">
        <span id="stage-completed">26 km completados</span>
        <span id="stage-remaining">12 km restantes</span>
      </div>
      <div class="mt-4 flex gap-2">
        <button
          type="button"
          class="rounded-xl px-3 py-2 ring-1 ring-stone-300 hover:bg-stone-50 active:scale-95 transition-transform"
          id="stage-decrease"
        >
          -5%
        </button>
        <button
          type="button"
          class="rounded-xl px-3 py-2 ring-1 ring-stone-300 hover:bg-stone-50 active:scale-95 transition-transform"
          id="stage-increase"
        >
          +5%
        </button>
      </div>
    </section>
  </div>

  <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section
      aria-labelledby="daily-planning-heading"
      class="rounded-2xl bg-white ring-1 ring-stone-200 p-6"
    >
      <h2 id="daily-planning-heading" class="text-lg font-700">
        Planificación Diaria
      </h2>
      <div class="mt-4 flex justify-between items-center">
        <span>Objetivo diario</span>
        <div class="flex gap-2 items-center">
          <button
            type="button"
            class="rounded-xl px-3 py-2 ring-1 ring-stone-300 hover:bg-stone-50 active:scale-95 transition-transform"
            id="goal-decrease"
          >
            -
          </button>
          <div class="px-3 py-2 font-700" id="daily-goal">
            25 km
          </div>
          <button
            type="button"
            class="rounded-xl px-3 py-2 ring-1 ring-stone-300 hover:bg-stone-50 active:scale-95 transition-transform"
            id="goal-increase"
          >
            +
          </button>
        </div>
      </div>
      <div class="mt-4">
        Promedio actual: {stats.averageDailyDistance} km/día
        <br />
        Estimado restante: {Math.ceil(stats.remainingDistance / 25)} días
      </div>
    </section>

    <div class="rounded-2xl bg-white ring-1 ring-stone-200 p-6">
      <h2 class="text-lg font-700">Recomendaciones</h2>
      <div class="mt-4 bg-stone-50 p-5 ring-1 ring-stone-200">
        <strong>¡Perfecto!</strong>
        <p>Tu ritmo es ideal para disfrutar el Camino sin agotarte.</p>
      </div>
    </div>
  </div>

  <div class="mt-6 bg-white ring-1 ring-stone-200 p-6">
    <h2 class="text-lg font-700">Datos Curiosos</h2>
    <div class="mt-4 grid md:grid-cols-2 gap-4">
      {funFacts.map((fact) => (
        <div class="bg-stone-50 ring-1 ring-stone-200 p-5">
          <strong>
            {fact.icon} {fact.title}
          </strong>
          <p>{fact.description}</p>
          <small>{fact.calculation}</small>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-6 bg-white ring-1 ring-stone-200 p-6">
    <h2 class="text-lg font-700">Próximas Etapas</h2>
    <div class="mt-4 grid gap-3">
      {pendingStages.map((stage) => (
        <div class="flex justify-between bg-stone-50 ring-1 ring-stone-200 p-4">
          <div>
            <strong>{stage.name}</strong>
            <div class={`mt-1 px-3 py-1 text-xs ring-1 ${difficultyPill(stage.difficulty)}`}>
              {stage.difficulty}
            </div>
          </div>
          <div>
            {stage.distance} km
            <br />
            {stage.estimatedDays} {stage.estimatedDays > 1 ? 'días' : 'día'}
          </div>
        </div>
      ))}
    </div>
  </div>

  <style>
    @keyframes goal-pulse {
      50% {
        transform: scale(1.03);
      }
    }
    .goal-pulse {
      animation: goal-pulse 350ms ease-out;
    }
    @media (prefers-reduced-motion: reduce) {
      .goal-pulse {
        animation: none;
      }
      * {
        transition: none !important;
      }
    }
  </style>

  <script>
    (function () {
      'use strict';

      // Astro bundles scripts, so document.currentScript is unreliable.
      const dashboard = document.querySelector('[data-hydrated="true"]');
      if (!dashboard) return;

      let stageProgress = 68;
      let dailyGoal = 25;
      let goalAnimating = false;

      const stageProgressEl = dashboard.querySelector('#stage-progress');
      const stageProgressBarEl = dashboard.querySelector('#stage-progress-bar');
      const stageCompletedEl = dashboard.querySelector('#stage-completed');
      const stageRemainingEl = dashboard.querySelector('#stage-remaining');
      const dailyGoalEl = dashboard.querySelector('#daily-goal');
      const stageDecreaseBtn = dashboard.querySelector('#stage-decrease');
      const stageIncreaseBtn = dashboard.querySelector('#stage-increase');
      const goalDecreaseBtn = dashboard.querySelector('#goal-decrease');
      const goalIncreaseBtn = dashboard.querySelector('#goal-increase');

      function updateStageProgress() {
        if (stageProgressEl) stageProgressEl.textContent = `${stageProgress}%`;
        if (stageProgressBarEl)
          (stageProgressBarEl as HTMLElement).style.width = `${stageProgress}%`;
        const totalDistance = 38.2;
        if (stageCompletedEl)
          stageCompletedEl.textContent = `${Math.round((totalDistance * stageProgress) / 100)} km completados`;
        if (stageRemainingEl)
          stageRemainingEl.textContent = `${Math.round((totalDistance * (100 - stageProgress)) / 100)} km restantes`;
      }

      function updateDailyGoalDisplay() {
        if (dailyGoalEl) {
          dailyGoalEl.textContent = `${dailyGoal} km`;
          if (goalAnimating) {
            dailyGoalEl.classList.add('goal-pulse');
            setTimeout(() => dailyGoalEl.classList.remove('goal-pulse'), 350);
          }
        }
        const estimatedDays = Math.ceil(720 / dailyGoal);
        const estimatedEl = dashboard.querySelector('div:has(#daily-goal) + div');
        if (estimatedEl) {
          const text = estimatedEl.textContent || '';
          estimatedEl.textContent = text.replace(
            /Estimado restante: \d+ días/,
            `Estimado restante: ${estimatedDays} días`
          );
        }
      }

      stageDecreaseBtn?.addEventListener('click', () => {
        stageProgress = Math.max(0, stageProgress - 5);
        updateStageProgress();
      });

      stageIncreaseBtn?.addEventListener('click', () => {
        stageProgress = Math.min(100, stageProgress + 5);
        updateStageProgress();
      });

      goalDecreaseBtn?.addEventListener('click', () => {
        dailyGoal = Math.max(15, dailyGoal - 1);
        goalAnimating = true;
        updateDailyGoalDisplay();
        requestAnimationFrame(() => {
          goalAnimating = false;
        });
      });

      goalIncreaseBtn?.addEventListener('click', () => {
        dailyGoal = Math.min(35, dailyGoal + 1);
        goalAnimating = true;
        updateDailyGoalDisplay();
        requestAnimationFrame(() => {
          goalAnimating = false;
        });
      });

      updateStageProgress();
      updateDailyGoalDisplay();
    })();
  </script>
</section>
