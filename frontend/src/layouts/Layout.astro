---
import '../styles/design-system.css';
import '../styles/animations.css';

export interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title = 'Albergue Municipal Carrascalejo',
  description = 'Albergue de peregrinos en el Camino de Santiago',
  showHeader = true,
  showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="module" src="/src/scripts/runtime.ts"></script>
    <!-- Swup View Transitions -->
    <meta name="view-transition" content="same-origin" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Indie+Flower&family=Patrick+Hand&family=Shadows+Into+Light&family=Cabin+Sketch:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="paper-texture min-h-screen">
    <div id="main-content" class="transition-fade">
      {showHeader && (
        <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200/60 shadow-sm">
          <nav class="container mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="text-2xl font-bold text-slate-800">🚶‍♂️</div>
                <div>
                  <h1 class="text-xl font-bold text-slate-800">Camino Dashboard</h1>
                  <p class="text-xs text-slate-600">Tu progreso en el Camino</p>
                </div>
              </div>

              <div class="hidden md:flex items-center gap-6">
                <a
                  href="/"
                  data-astro-prefetch
                  class="text-slate-700 hover:text-slate-900 font-medium transition-colors"
                >
                  Inicio
                </a>
                <a
                  href="/camino"
                  data-astro-prefetch
                  class="text-slate-700 hover:text-slate-900 font-medium transition-colors"
                >
                  Dashboard
                </a>
                <a
                  href="/book"
                  data-astro-prefetch
                  class="text-slate-700 hover:text-slate-900 font-medium transition-colors"
                >
                  Reservas
                </a>
                <a
                  href="/auth"
                  data-astro-prefetch
                  class="bg-slate-800 text-white px-4 py-2 rounded-lg hover:bg-slate-900 transition-colors font-medium"
                >
                  Iniciar Sesión
                </a>
              </div>

              <button class="md:hidden p-2 rounded-lg hover:bg-slate-100">
                <span class="text-slate-700">☰</span>
              </button>
            </div>
          </nav>
        </header>
      )}

      <main>
        <slot />
      </main>

      {showFooter && (
        <footer class="bg-slate-800 text-white py-8 mt-16">
          <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div>
                <h3 class="text-lg font-bold mb-4">Camino Dashboard</h3>
                <p class="text-slate-300 text-sm">
                  Tu compañero de viaje en el Camino de Santiago. Registra tu progreso y comparte tu
                  experiencia.
                </p>
              </div>
              <div>
                <h4 class="font-semibold mb-4">Enlaces útiles</h4>
                <ul class="space-y-2 text-slate-300 text-sm">
                  <li>
                    <a href="#" class="hover:text-white transition-colors">
                      Guía del peregrino
                    </a>
                  </li>
                  <li>
                    <a href="#" class="hover:text-white transition-colors">
                      Albergues
                    </a>
                  </li>
                  <li>
                    <a href="#" class="hover:text-white transition-colors">
                      Rutas
                    </a>
                  </li>
                </ul>
              </div>
              <div>
                <h4 class="font-semibold mb-4">Contacto</h4>
                <p class="text-slate-300 text-sm">
                  ¿Preguntas o sugerencias?
                  <br />
                  <a
                    href="mailto:info@camino.com"
                    class="text-slate-300 hover:text-white transition-colors"
                  >
                    info@camino.com
                  </a>
                </p>
              </div>
            </div>
            <div class="border-t border-slate-700 mt-8 pt-8 text-center text-slate-400 text-sm">
              © 2024 Camino Dashboard. Hecho con ❤️ para peregrinos.
            </div>
          </div>
        </footer>
      )}
    </div>
  </body>
</html>
