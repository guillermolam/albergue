---
import '../styles/tailwind.css';
import { Navigation } from '../../react/Navigation';
import { Footer } from '../../react/Footer';
import { backendJson } from '../lib/backend-api';
import type { HostelAggregate } from '../lib/hostelTypes';

export interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title = 'Albergue Municipal Carrascalejo',
  description = 'Albergue de peregrinos en el Camino de Santiago',
  showHeader = true,
  showFooter = true,
} = Astro.props;

// Runs at build time for still-prerendered pages (fine -- footer content
// changes rarely, refreshes on every deploy) and live for on-demand SSR
// pages. Falls back to Footer's own static footerData.ts constants when the
// backend isn't reachable, so a broken/unconfigured backend never breaks
// the footer.
let hostelInfo: HostelAggregate | null = null;
if (showFooter) {
  const result = await backendJson<HostelAggregate>('/api/hostel');
  if (result.ok) hostelInfo = result.data;
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="module" src="/src/scripts/runtime.ts"></script>
    <!-- Swup View Transitions -->
    <meta name="view-transition" content="same-origin" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Indie+Flower&family=Patrick+Hand&family=Shadows+Into+Light&family=Cabin+Sketch:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="paper-texture min-h-screen">
    <div id="main-content" class="transition-fade">
      {showHeader && <Navigation currentPath={Astro.url.pathname} client:load />}

      <main>
        <slot />
      </main>

      {showFooter && <Footer client:visible hostelInfo={hostelInfo} />}
    </div>
  </body>
</html>
