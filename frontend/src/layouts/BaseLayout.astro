---
const {
  title = 'Camino Dashboard',
  description = 'Albergue de peregrinos en el Camino de Santiago',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="view-transition" content="same-origin" />
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900">
    <div id="main-content" class="transition-fade">
      <slot />
    </div>
    <script type="module" src="/src/scripts/runtime.ts"></script>
  </body>
</html>
