---
const { title = 'Camino Dashboard' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Import map for inline module scripts that need roughjs -->
    <script type="importmap">
      {
        "imports": {
          "roughjs/bundled/rough.esm.js": "https://esm.sh/roughjs@4.6.6/bundled/rough.esm.js",
          "animejs": "https://esm.sh/animejs@4.5.0",
          "animejs/lib/anime.es.js": "https://esm.sh/animejs@4.5.0"
        }
      }
    </script>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900">
    <slot />
    <script type="module" src="/src/scripts/runtime.ts"></script>
  </body>
</html>
