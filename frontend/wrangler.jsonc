{
  // Must match the actually-deployed Worker name, not a display/branding
  // name — a mismatch here makes `wrangler deploy` create a second, empty
  // Worker instead of updating the live one at albergue.<subdomain>.workers.dev.
  "name": "albergue",
  "compatibility_date": "2025-05-21",
  // @astrojs/react's SSR code imports Node built-ins (e.g. node:stream) that
  // the Workers runtime only provides under this flag.
  // Also required for the backend's `pg` dependency (real TCP sockets),
  // now bundled into this same Worker -- see src/lib/backend-api.ts.
  "compatibility_flags": ["nodejs_compat"],

  // Astro sessions + camino's anonymous km-log storage use the Cloudflare KV
  // driver with the `SESSION` binding (see src/pages/api/camino/[...path].ts).
  "kv_namespaces": [{ "binding": "SESSION", "id": "bed54f740ffb43c58ab2ef2c36434408" }],

  // The merged backend code (src/lib/backend-api.ts -> albergue-backend/app)
  // reads this to decide whether to enable TLS/cert validation on the
  // Postgres pool (backend/src/lib/db.ts) -- carried over from the
  // standalone backend Worker's own wrangler.jsonc, which set this the
  // same way. Without it, DB traffic runs without TLS.
  "vars": {
    "NODE_ENV": "production",
  },
}
