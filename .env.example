# Template for the monorepo-root `.env` -- KEY NAMES ONLY, never values.
# Copy to `.env` and fill in. The real `.env` is gitignored.
#
# Smplrspace note: the frontend does NOT get its own copy of these. Astro only
# reads `frontend/.env`, so `frontend/scripts/root-env.mjs` bridges an explicit
# allowlist from this file into PUBLIC_SMPLR_* at config load:
#   SMPLRSPACE_ORG_ID      -> PUBLIC_SMPLR_ORGANIZATION_ID
#   SMPLRSPACE_API_TOKEN   -> PUBLIC_SMPLR_CLIENT_TOKEN
#   SMPLRSPACE_PUBLIC_URL  -> PUBLIC_SMPLR_SPACE_B01_ID  (https://smplr.me/v/<code> -> spc_<code>)
# Set SMPLRSPACE_SPACE_B0{1,2,3}_ID here to override that derivation.
# Only those keys cross into the frontend process -- everything else below
# stays server-side and must never be referenced from client code.


# --- STORMKIT ---
STORMKIT_ALBERGUE_KEY=

# --- REDIS ---
REDIS_API_KEY=
REDIS_DB_NAME=
REDIS_DB_ID=
REDIS_CONNECT_URL=

# --- AWS ---
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- NEON ---
NEON_REGION=
NEON_DEFAULT_BRANCH=
NEON_PROD_BRANCH_ID=
NEON_DEVELOPMENT_BRANCH_ID=
NEON_PROJECT_ID=
NEON_AI_GATEWAY_TOKEN=
NEON_MACOS_PAT=
NEON_DATABASE_URL_NEON_OWNER=
NEON_DATABASE_URL_AUTHENTICATOR=
NEON_DATABASE_URL_ANONYMOUS=
NEON_DATABASE_URL_AUTHENTICATED=

# --- TURSO ---
TURSO_URL=
TURSO_API_TOKEN=
TURSO_DB_URL=
TURSO_DB_TOKEN=

# --- MUX ---
MUX_URL=
MUX_ENV_KEY=
MUX_ENV_ID=
MUX_TOKEN_ID=
MUX_SECRET_KEY=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_SECRET_KEY=

# --- CLOUDFLARE ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_NAMESPACE_NAME=
CLOUDFLARE_KV_NAMESPACE_KEY=
CLOUDFLARE_KV_NAMESPACE_VALUE=
CLOUDFLARE_KV_NAMESPACE_EXPIRATION=
CLOUDFLARE_KV_NAMESPACE_MAX_TTL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=

# --- NGROK ---
NGROK_AUTH_TOKEN=
NGROK_LOCAL_FILE_PATH=
NGROK_PUBLIC_URL=

# --- NETLIFY ---
NETLIFY_API_TOKEN=
NETLIFY_PROJECT_NAME=
NETLIFY_SITE_ID=

# --- SMPLRSPACE ---
SMPLRSPACE_PROJECT_ID=
SMPLRSPACE_PROJECT_URL=
SMPLRSPACE_PRIVATE_URL=
SMPLRSPACE_PUBLIC_URL=
SMPLRSPACE_API_TOKEN=
SMPLRSPACE_ORG_ID=

# --- PUBLIC ---
PUBLIC_SMPLR_ORGANIZATION_ID=
PUBLIC_SMPLR_CLIENT_TOKEN=

# Optional explicit Smplrspace space ids (otherwise derived from SMPLRSPACE_PUBLIC_URL)
SMPLRSPACE_SPACE_B01_ID=
SMPLRSPACE_SPACE_B02_ID=
SMPLRSPACE_SPACE_B03_ID=
