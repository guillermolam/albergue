{
  "name": "albergue",
  "version": "1.0.0",
  "description": "Albergue Municipal Carrascalejo - Monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm --filter @albergue/domain-model --filter @albergue/api-contract --filter albergue-backend build",
    "dev": "pnpm --filter albergue-carrascalejo-frontend dev",
    "dev:backend": "pnpm --filter albergue-backend dev",
    "dev:all": "pnpm --parallel dev",
    "build": "pnpm --filter albergue-carrascalejo-frontend build",
    "build:all": "pnpm --recursive build",
    "type-check": "pnpm --recursive type-check",
    "test": "pnpm --filter albergue-backend test"
  },
  "keywords": [
    "camino-de-santiago",
    "albergue",
    "astro",
    "hono"
  ],
  "author": "Albergue Municipal Carrascalejo",
  "license": "MIT"
}
